# syntax=docker/dockerfile:1.7
FROM node:25-bookworm-slim AS node-deps
WORKDIR /app
# Refreshes npm's own bundled deps (tar, brace-expansion, ip-address, undici) before
# anything under /usr/local/lib/node_modules gets copied into the final image. Pinned
# to the newest npm 11 (not @latest): npm 12 declares support for Node 22/24/26 only,
# and this image's base is Node 25. Re-check when a release bundles undici >= 6.29.1.
RUN npm install -g npm@11.21.1
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts
RUN npx playwright install --with-deps chromium

FROM python:3.15-slim-bookworm AS python-deps
ENV PIP_DISABLE_PIP_VERSION_CHECK=1 PIP_NO_CACHE_DIR=1
WORKDIR /app
COPY pyproject.toml ./
COPY orchestrator ./orchestrator
COPY agents ./agents
COPY github_integration ./github_integration
COPY prompts ./prompts
COPY templates ./templates
COPY playwright ./playwright
RUN python -m venv /opt/venv && /opt/venv/bin/pip install --upgrade pip setuptools wheel \
    && /opt/venv/bin/pip install .

FROM python:3.15-slim-bookworm
ENV PATH=/opt/venv/bin:/usr/local/bin:$PATH \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright \
    ZYVOR_NO_SANDBOX=false \
    ZYVOR_PW_WORKERS=2 \
    ZYVOR_ENV=production

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates dumb-init \
    libnss3 libnspr4 libdbus-1-3 libatk1.0-0 libatk-bridge2.0-0 \
    libcups2 libdrm2 libxkbcommon0 libxcomposite1 libxdamage1 libxfixes3 \
    libxrandr2 libgbm1 libpango-1.0-0 libcairo2 libasound2 \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --system --gid 10001 zyvor \
    && useradd --system --uid 10001 --gid 10001 --home /app --shell /usr/sbin/nologin zyvor

# Patches CVEs in the base image's own bundled pip/setuptools (unused at runtime —
# the app only ever runs via /opt/venv — but still scanned by container-scan).
RUN pip install --no-cache-dir --upgrade pip setuptools

WORKDIR /app
COPY --from=node-deps /usr/local/bin/node /usr/local/bin/node
COPY --from=node-deps /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -sf /usr/local/lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
    && ln -sf /usr/local/lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx
COPY --from=python-deps /opt/venv /opt/venv
COPY --from=node-deps /app/node_modules ./node_modules
COPY --from=node-deps /root/.cache/ms-playwright /ms-playwright
COPY package.json tsconfig.json ./
COPY orchestrator ./orchestrator
COPY agents ./agents
COPY github_integration ./github_integration
COPY prompts ./prompts
COPY templates ./templates
COPY playwright ./playwright
RUN mkdir -p /app/reports /app/screenshots /app/test-results \
    && chown -R zyvor:zyvor /app /ms-playwright

USER 10001:10001
EXPOSE 8080
ENTRYPOINT ["/usr/bin/dumb-init", "--", "argus"]
CMD ["serve", "--host", "0.0.0.0", "--port", "8080"]
