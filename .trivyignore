# Vulnerabilities in npm's OWN bundled internal dependencies (not this project's
# runtime dependency graph — `npm ls` shows none of these), disclosed after the
# latest npm release that still supports this image's Node 20 (npm 12+ requires
# Node >=22). Re-check and remove these as soon as a Node-20-compatible npm
# release ships a fix, or the base image moves to Node 22+.
CVE-2026-14257  # brace-expansion (npm-bundled) — fixed only in npm 12+ (Node >=22)
CVE-2026-69152  # brace-expansion (npm-bundled) — fixed only in npm 12+ (Node >=22)
CVE-2026-69192  # ip-address (npm-bundled, via socks) — no Node-20-compatible npm fix yet
CVE-2026-102276  # brace-expansion (npm-bundled) — fixed only in npm 12+ (Node >=22)
CVE-2026-102278  # brace-expansion (npm-bundled) — fixed only in npm 12+ (Node >=22)
CVE-2026-19534  # undici (npm-bundled) — no Node-20-compatible npm fix yet
CVE-2026-73566  # tar (npm-bundled) — fixed only in npm 12+ (Node >=22); confirmed via usr/local/lib/node_modules/npm/node_modules/tar

# msgpack (GHSA-6v7p-g79w-8964) and setuptools (CVE-2025-47273) are pinned past
# these in pyproject.toml, and trivy's own per-file listing confirms
# /opt/venv/.../msgpack-1.2.1.dist-info and setuptools-83.0.0.dist-info are
# present and clean — but its vulnerability table still separately reports the
# old versions from a location we could not identify without direct image
# access. Remove once someone can `docker run --rm -it <image> sh` and find
# the actual second copy (or confirm this is a trivy scan-cache artifact).
GHSA-6v7p-g79w-8964
CVE-2025-47273

# urllib3 2.7.0 reported in the image is the copy vendored inside pip itself
# (pip/_vendor/urllib3), not a project dependency: pyproject.toml floors the
# real package at >=2.8.0. Remove once a pip release vendors urllib3 >=2.8.0.
CVE-2026-97687
CVE-2026-97689
