# Full annotated reference for every variable: docs/configuration.md

# LLM Provider (openai | anthropic | azure | ollama | google)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o

# Provider API keys (set the one matching LLM_PROVIDER)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
GOOGLE_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# GitHub (optional if `gh auth login` is configured)
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=
ZYVOR_PRODUCT_REPO=owner/zyvor-monorepo

# Zyvor targets (single URL — marketing site or dashboard)
ZYVOR_BASE_URL=https://zyvor.dev

# Optional: only needed for a real dashboard (not zyvor.dev marketing site)
# ZYVOR_STAGING_URL=
# ZYVOR_TEST_USER=
# ZYVOR_TEST_PASSWORD=
# ENABLE_DASHBOARD_TESTS=false

# Phase 2 feature flags
ENABLE_REGRESSION=false
ENABLE_API_VALIDATION=true
REGRESSION_THRESHOLD=1.0
UPDATE_BASELINES=false

# Phase 3 feature flags
ENABLE_LLM_ANALYSIS=true
ENABLE_LLM_REPORT=true
ENABLE_PDF_REPORT=true
ENABLE_AUTOFIX=false
ENABLE_AUTOFIX_APPLY=false
AUTOFIX_MAX_RETRIES=2
# Where confirmed autofix fixes are remembered across runs. Cache this path
# in CI (e.g. actions/cache) if you want skills to persist across workflow runs.
SKILLS_PATH=.zyvor-argus/skills.json

# Advanced coverage features
ENABLE_LIVE_CRAWL=false
CRAWL_MAX_PAGES=50
CRAWL_MAX_DEPTH=2
CRAWL_TIMEOUT_SECONDS=120
ENABLE_V8_COVERAGE=false

# Phase 4 feature flags
ENABLE_MULTI_BROWSER=false
ENABLE_RUST_PROCESSOR=false
ZYVOR_DIFF_BINARY=

# Playwright suite extras
# ENABLE_AUTH_SETUP=false          # login once via setup project → playwright/.auth/user.json
# ENABLE_EMULATION_PROJECTS=false  # dark / reduced-motion / locale projects
# ZYVOR_LOCALE=en-US
# ZYVOR_GREP=@smoke                # filter tests by tag (also: argus test exec --grep)
# ZYVOR_SHARD=1/2                  # CI sharding (also: --shard)
# ZYVOR_HAR_PATH=                  # default HAR file for argus api har-replay --mode replay
# ZYVOR_PW_WORKERS=2

# Mission Control dashboard (argus serve → /dashboard)
# DASHBOARD_NAMESPACE=default
# DASHBOARD_POD_SELECTOR=app=argus
# Login (Zyvor premium login screen) — auth is enforced when PASSWORD is set
# DASHBOARD_USER=admin
# DASHBOARD_PASSWORD=
# DASHBOARD_SECRET=            # optional explicit session-signing secret
# Set automatically by desktop/ (Tauri app) — hides the always-empty
# Kubernetes pods/workloads panel. Not meant to be set by hand.
# ZYVOR_DESKTOP_MODE=false
# Target-under-test extras (Test-any-site action sets these per job)
# ZYVOR_IGNORE_HTTPS_ERRORS=false   # accept self-signed TLS on the target

# Coverage expansion (reads product repo docs/code to generate missing tests)
ENABLE_COVERAGE_EXPANSION=false
COVERAGE_MAX_NEW_TESTS=10
# COVERAGE_DISCOVERY_PATHS=docs/,docs/specs/,src/pages/,src/routes/,app/
# COVERAGE_MAX_DISCOVERY_FILES=200
# COVERAGE_MAX_DISCOVERY_BYTES=2000000

# Notification channels (Phase 3)
SLACK_WEBHOOK_URL=
# Slack slash command gateway (POST /webhook/slack/command): trigger/check
# jobs from chat with `/zyvor run <kind>` / `/zyvor status <job_id>`.
# Required to accept slash commands at all — requests are rejected without it.
SLACK_SIGNING_SECRET=
TEAMS_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIFY_EMAIL_TO=

# Enterprise v2 security and persistence
# ZYVOR_ENV=production
# ZYVOR_STATE_DB=reports/mission-control.db
# ZYVOR_TARGET_ALLOWLIST=zyvor.dev,*.zyvor.dev
# ZYVOR_TARGET_ALLOWED_PORTS=80,443
# ZYVOR_TARGET_ALLOWED_CIDRS=
# ZYVOR_ALLOW_PRIVATE_TARGETS=false
# ZYVOR_ALLOW_HTTP_TARGETS=false
# ZYVOR_AGENT_MODE=read_only
# ZYVOR_AGENT_APPROVED_RISKS=
# ZYVOR_AGENT_ALLOW_DESTRUCTIVE=false
# Per-IP request throttling for /api/dashboard/* and /api/v2/*
# ZYVOR_API_RATE_LIMIT=120
# ZYVOR_API_RATE_WINDOW_S=60
# Dead-letter a job instead of requeuing it forever after this many crashed attempts
# ZYVOR_JOB_MAX_ATTEMPTS=3
# ZYVOR_AGENT_ALLOWED_ORIGINS=
# ZYVOR_API_TOKENS_FILE=
# Gates misconfig_scan/cve_lookup/llm_redteam behind an authorized security
# engagement (POST /api/v2/engagements) — see docs/enterprise-v2.md. Refused
# at startup if set to "disabled" when ZYVOR_ENV=production.
# ZYVOR_ENGAGEMENT_ENFORCEMENT=required
# exploit_poc sandbox (kubernetes/sandbox.yaml) — PoC code runs in a
# short-lived K8s Job in this namespace, never in this process. Unset =
# exploit_poc is unavailable (fails closed), even with an 'exploit'-tier
# engagement.
# ZYVOR_SANDBOX_NAMESPACE=argus-sandbox
# ZYVOR_SANDBOX_SERVICE_ACCOUNT=argus-sandbox
# ZYVOR_SANDBOX_IMAGE=python:3.12-slim
# Separate, independent opt-in for exploit_poc/attack_chain — an
# 'exploit'-tier engagement alone is not enough; both gates must be
# satisfied. Default: disabled.
# ZYVOR_EXPLOIT_EXECUTION_ENABLED=false
# DAST / network-attack probes (dast_scan, injection_scan, csrf_probe,
# ssrf_probe, auth_attack_scan, idor_scan) need an exploit-tier engagement
# PLUS this independent opt-in. Optional nuclei binary for dast_scan templates.
# ZYVOR_DAST_SCAN_ENABLED=false
# ZYVOR_DAST_NUCLEI_BIN=
# host_pentest/cloud_pentest need everything above PLUS this third,
# independent opt-in, PLUS a specially-imaged sandbox (the default
# ZYVOR_SANDBOX_IMAGE lacks paramiko/cloud CLIs) — unset image vars = fails
# closed. Credentials must be {"$secret": "env:NAME"} refs, never raw values.
# ZYVOR_CREDENTIALED_PENTEST_ENABLED=false
# ZYVOR_SANDBOX_HOST_IMAGE=
# ZYVOR_SANDBOX_CLOUD_IMAGE=


# Optional Ask Zyra knowledge RAG (see .env.knowledge.example / docs/tutorials/14-ask-zyvor-knowledge.md)
# pip install -e '.[knowledge]' then set:
# LLM_API_KEY=
# QDRANT_URL=http://localhost:6333
# EMBEDDING_BACKEND=fastembed   # local FastEmbed when Ollama embeddings 400
# EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# JIRA_OAUTH_ACCESS_TOKEN=      # preferred over Basic for live Jira
# JIRA_OAUTH_REFRESH_TOKEN=
# JIRA_OAUTH_CLIENT_ID=
# JIRA_OAUTH_CLIENT_SECRET=
# IMAP_HOST=imap.gmail.com
# IMAP_USER=
# IMAP_PASSWORD=                # Gmail app password
# ZYVOR_DIARIZE_CMD='whisperx {input} --output_dir .'  # or API:
# ZYVOR_DIARIZE_API_URL=

# APP_API_KEY=change-me
# KNOWLEDGE_TENANT_ID=public
# KNOWLEDGE_ACCESS_LEVELS=public,user

# Scheduler cadence (Mission Control schedules)
# Default advances from wall-clock now (drops missed ticks). Catch-up preserves
# next_at + interval. Skip-if-busy leaves a due schedule pending while a job runs.
# ZYVOR_SCHEDULE_CATCHUP=false
# ZYVOR_SCHEDULE_SKIP_IF_BUSY=false
# Jobs run one at a time by default. Raise this (max 16) to let concurrency-safe kinds
# (HTTP probes, ping, tls, port_scan, tls_cipher_scan) run beside the running job, each with
# its own progress and cancel (GET /api/dashboard/jobs, POST /api/dashboard/jobs/{id}/cancel).
# Playwright-based and file-writing kinds always serialize.
# ZYVOR_JOBS_MAX_CONCURRENT=1

# Jira connector (argus test run --source jira): JSON export path and/or live REST
# JIRA_BASE_URL=https://your.atlassian.net
# JIRA_API_TOKEN=
# JIRA_USER=you@example.com
