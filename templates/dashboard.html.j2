      + "<tr><th>title</th><th>source</th><th>version</th><th>quality</th><th>updated</th></tr>"
      + list.map((r) => '<tr class="req-row" data-id="' + esc(r.id) + '" style="cursor:pointer">'
        + "<td>" + esc(r.title) + '<div class="d"><code>' + esc(r.id) + "</code></div></td>"
        + '<td class="d">' + esc(r.source_type) + (r.origin_id ? ' <span class="d">· ' + esc(r.origin_id) + "</span>" : "") + "</td>"
        + '<td class="d">v' + esc(r.latest_version) + "</td>"
        + '<td><span class="chip" style="color:' + scoreColor(r.quality_score) + '">' + (r.quality_score != null ? Math.round(r.quality_score) : "—") + "</span></td>"
