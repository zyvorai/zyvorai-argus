      <div class="act-row"><textarea class="inp grow" id="cp-finding" rows="2" placeholder="describe what to verify, e.g. 'S3 bucket policy grants public read access'"></textarea></div>
      <div class="act-row"><textarea class="inp grow" id="cp-creds" rows="2" placeholder='creds as JSON — non-secret fields inline, secret fields as {"$secret": "env:NAME"}, e.g. {"access_key_id": "AKIA...", "secret_access_key": {"$secret": "env:AWS_SECRET"}}'></textarea></div>
      <div class="act-row">
        <select class="inp grow eng-select" id="cp-eng"><option value="">— select an authorized engagement —</option></select>
        <button class="run-btn act-btn" data-kind="cloud_pentest" style="margin-left:auto">☁️ Generate &amp; verify</button>
      </div>
    </div>
