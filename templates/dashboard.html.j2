<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Zyvor Mission Control</title>
<script>
(function () {
  var t = null;
  try { t = localStorage.getItem("zyvor-theme"); } catch (e) {}
  // No saved choice: follow the OS preference (dark remains the fallback).
  if (!t && window.matchMedia && matchMedia("(prefers-color-scheme: light)").matches) t = "light";
  document.documentElement.setAttribute("data-theme", t === "light" ? "light" : "dark");
})();
</script>
<style>
  /* Zyvor Argus — Mission Control (Apple-style, dark default) */
  :root {
    color-scheme: dark;
    --bg: #1d1d1f;
    --surface: #2c2c2e;
    --rail-bg: #161617;
    --text: #f5f5f7;
    --text-secondary: #a1a1a6;
    --text-muted: #a1a1a6;
    --border: #424245;
    --accent: #2997ff;
    --accent-hover: #0077ed;
    --radius: 12px;
    --rail-width: 240px;
    --rail-width-collapsed: 56px;
    --status-ok: #30d158;
    --status-warn: #ff9f0a;
    --status-error: #ff453a;
    --status-info: #2997ff;
    --status-neutral: #86868b;
    --font-base: -apple-system, BlinkMacSystemFont, "SF Pro Text", "Segoe UI", system-ui, sans-serif;
    --font-mono: ui-monospace, "SF Mono", SFMono-Regular, Menlo, monospace;
    --ease-out: cubic-bezier(0.22, 1, 0.36, 1);
    --hover-bg: rgba(255,255,255,0.06);
    --header-bg: rgba(29,29,31,0.82);
    --shadow-sm: 0 2px 12px rgba(0,0,0,0.35);
    --shadow-md: 0 4px 16px rgba(0,0,0,0.45);
    --code-bg: #3a3a3c;
    --icon-badge-bg: #252527;
    --focus-ring: rgba(41,151,255,0.28);
    --accent-soft: rgba(41,151,255,0.14);
    --accent-border-soft: rgba(41,151,255,0.38);
    --accent-bg-soft: rgba(41,151,255,0.1);
    --btn-hover-bg: #353537;
    --overlay-bg: rgba(0,0,0,0.55);
    --palette-overlay: rgba(0,0,0,0.62);
    /* legacy aliases for JS inline styles */
    --separator: var(--border);
    --text-primary: var(--text);
    --surface-base: var(--surface);
    --surface-elevated: #323234;
    --surface-muted: #252527;
    --fill-secondary: #2c2c2e;
    --glass-border-strong: var(--border);
    --accent-2: var(--accent);
    --radius-liquid: var(--radius);
  }
  [data-theme="light"] {
    color-scheme: light;
    --bg: #fbfbfd;
    --surface: #ffffff;
    --rail-bg: #f5f5f7;
    --text: #1d1d1f;
    --text-secondary: #6e6e73;
    --text-muted: #6e6e73;
    --border: #d2d2d7;
    --accent: #0071e3;
    --accent-hover: #0077ed;
    --status-ok: #34c759;
    --status-warn: #b45309;
    --status-error: #ff3b30;
    --status-info: #0071e3;
    --hover-bg: rgba(0,0,0,0.04);
    --header-bg: rgba(251,251,253,0.88);
    --shadow-sm: 0 2px 8px rgba(0,0,0,0.04);
    --shadow-md: 0 4px 12px rgba(0,0,0,0.06);
    --code-bg: #eee;
    --icon-badge-bg: #f5f5f7;
    --focus-ring: rgba(0,113,227,0.15);
    --accent-soft: rgba(0,113,227,0.08);
    --accent-border-soft: rgba(0,113,227,0.35);
    --accent-bg-soft: rgba(0,113,227,0.06);
    --btn-hover-bg: #fafafa;
    --overlay-bg: rgba(0,0,0,0.28);
    --palette-overlay: rgba(0,0,0,0.28);
    --surface-elevated: #fafafa;
    --surface-muted: #f5f5f7;
    --fill-secondary: #f5f5f7;
  }
  * { box-sizing: border-box; }
  html, body { min-height: 100%; margin: 0; }
  body {
    background: var(--bg); color: var(--text);
    font-family: var(--font-base); font-size: 16px; line-height: 1.47059;
    letter-spacing: -0.022em; -webkit-font-smoothing: antialiased;
  }

  .app { display: flex; min-height: 100vh; }
  .side-rail {
    position: fixed; top: 0; left: 0; bottom: 0; width: var(--rail-width);
    background: var(--rail-bg); border-right: 1px solid var(--border);
    display: flex; flex-direction: column; z-index: 20; overflow-x: hidden; overflow-y: auto;
    transition: width 0.25s var(--ease-out);
  }
  .rail-brand {
    padding: 20px 20px 16px;
  }
  .rail-brand strong {
    display: block; font-size: 0.82rem; font-weight: 500;
    letter-spacing: -0.01em; color: var(--text-secondary); margin-top: 10px;
  }
  .zyvor-mark {
    display: inline-flex; align-items: center; gap: 7px;
    color: var(--text); text-decoration: none;
  }
  .zyvor-mark:hover { text-decoration: none; color: var(--text); }
  .zyvor-mark .mark-word {
    font-weight: 700; font-size: 15px; letter-spacing: -0.03em;
  }
  .header-mark { display: none; }
  .rail-nav { flex: 1; padding: 0 12px 24px; }
  .rail-group { margin-top: 18px; }
  .rail-group-label {
    font-size: 0.68rem; font-weight: 600; letter-spacing: 0.08em;
    text-transform: uppercase; color: var(--text-muted); padding: 0 8px 6px;
  }
  .rail-link {
    display: flex; align-items: center; gap: 10px;
    width: 100%; text-align: left; border: none; background: none;
    font: inherit; font-size: 0.92rem; color: var(--text-secondary); padding: 8px 12px;
    border-radius: 8px; cursor: pointer; position: relative; transition: color .15s, background .15s;
  }
  .rail-link .rail-icon {
    width: 16px; height: 16px; flex: none; opacity: 0.65;
  }
  .rail-link:hover .rail-icon { opacity: 0.9; }
  .rail-link.is-active .rail-icon { opacity: 1; color: var(--accent); }
  .rail-link:hover { color: var(--text); background: var(--hover-bg); }
  .rail-link.is-active {
    color: var(--text); font-weight: 600; background: var(--accent-soft);
  }
  .rail-link.is-active::before {
    content: ""; position: absolute; left: 0; top: 6px; bottom: 6px; width: 3px;
    border-radius: 0 2px 2px 0; background: var(--accent);
  }
  .rail-footer {
    padding: 12px; border-top: 1px solid var(--border); margin-top: auto;
  }
  .rail-collapse {
    display: flex; align-items: center; gap: 10px; width: 100%;
    border: none; background: none; font: inherit; font-size: 0.85rem;
    color: var(--text-muted); padding: 8px 12px; border-radius: 8px; cursor: pointer;
  }
  .rail-collapse:hover { color: var(--text); background: var(--hover-bg); }
  .rail-collapse svg { width: 16px; height: 16px; flex: none; transition: transform 0.25s var(--ease-out); }

  body.rail-collapsed .side-rail { width: var(--rail-width-collapsed); }
  body.rail-collapsed .main-column { margin-left: var(--rail-width-collapsed); }
  body.rail-collapsed .rail-brand { padding: 16px 0; text-align: center; }
  body.rail-collapsed .rail-brand .mark-word,
  body.rail-collapsed .rail-brand strong,
  body.rail-collapsed .rail-group-label,
  body.rail-collapsed .rail-link-label,
  body.rail-collapsed .rail-collapse-label { display: none; }
  body.rail-collapsed .zyvor-mark { justify-content: center; }
  body.rail-collapsed .rail-nav { padding: 0 8px 12px; }
  body.rail-collapsed .rail-link {
    justify-content: center; padding: 10px 8px;
  }
  body.rail-collapsed .rail-link .rail-icon { width: 18px; height: 18px; opacity: 0.85; }
  body.rail-collapsed .rail-group { margin-top: 6px; padding-top: 6px; }
  body.rail-collapsed .rail-group + .rail-group { border-top: 1px solid var(--border); }
  body.rail-collapsed .rail-collapse { justify-content: center; padding: 10px 8px; }
  body.rail-collapsed .rail-collapse svg { transform: rotate(180deg); }

  .main-column {
    flex: 1; margin-left: var(--rail-width); min-width: 0;
    display: flex; flex-direction: column; min-height: 100vh;
    transition: margin-left 0.25s var(--ease-out);
  }
  .global-header {
    position: sticky; top: 0; z-index: 10; display: flex; align-items: center; gap: 12px;
    padding: 12px 32px; background: var(--header-bg);
    backdrop-filter: saturate(180%) blur(20px); -webkit-backdrop-filter: saturate(180%) blur(20px);
    border-bottom: 1px solid var(--border);
  }
  .global-header-spacer { flex: 1; }
  .menu-btn {
    display: none; border: 1px solid var(--border); background: var(--surface);
    border-radius: 8px; padding: 6px 10px; cursor: pointer; font-size: 1rem;
  }
  .panel-viewport { flex: 1; padding: 24px 32px 32px; }
  .panel { display: none; animation: panel-in 0.35s var(--ease-out); }
  .panel.is-active { display: block; }
  @keyframes panel-in { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }
  .panel-head { margin-bottom: 24px; }
  .panel-head h1 { font-size: clamp(2rem, 4vw, 2.75rem); font-weight: 600; letter-spacing: -0.03em; margin: 0 0 6px; }
  .panel-head p { margin: 0; color: var(--text-secondary); font-size: 1.05rem; }

  .hero {
    border: none; border-radius: var(--radius); background: var(--surface);
    box-shadow: var(--shadow-sm); padding: 28px 32px; margin-bottom: 24px;
  }
  .hero-shine { display: none; }
  .hero-head { display: flex; align-items: flex-start; gap: 20px; flex-wrap: wrap; }
  .icon-badge {
    display: flex; align-items: center; justify-content: center; width: 48px; height: 48px;
    border-radius: 12px; flex: none; background: var(--icon-badge-bg); border: 1px solid var(--border);
    color: var(--accent);
  }
  .hero h1 { font-size: clamp(2rem, 3.5vw, 2.75rem); font-weight: 600; letter-spacing: -0.03em; margin: 0; }
  .hero .subtitle { color: var(--text-secondary); font-size: 1rem; margin-top: 4px; }
  .hero .sync { margin-left: auto; color: var(--text-muted); font-size: 0.875rem; text-align: right; }
  .status-line { display: inline-flex; align-items: center; gap: 8px; }
  .status-line .lamp { width: 10px; height: 10px; border-radius: 50%; flex: none; }
  .hero[data-status="go"] .lamp { background: var(--status-ok); }
  .hero[data-status="go"] h1 span { color: var(--status-ok); }
  .hero[data-status="degraded"] .lamp { background: var(--status-warn); }
  .hero[data-status="degraded"] h1 span { color: var(--status-warn); }
  .hero[data-status="down"] .lamp { background: var(--status-error); }
  .hero[data-status="down"] h1 span { color: var(--status-error); }
  .hero[data-status="offline"] .lamp { background: var(--status-neutral); }
  .brand-eyebrow { font-size: 0.75rem; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--text-muted); }

  .stat-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(168px, 1fr)); gap: 12px; margin-top: 24px; }
  .stat-tile {
    display: flex; flex-direction: column; align-items: flex-start; gap: 2px;
    min-width: 0; padding: 16px 18px; border-radius: var(--radius); border: 1px solid var(--border);
    background: var(--surface);
  }
  .stat-label {
    display: block; width: 100%;
    font-size: 0.75rem; font-weight: 600; color: var(--text-muted);
    text-transform: uppercase; letter-spacing: 0.04em;
  }
  .stat-value {
    display: block; width: 100%;
    font-size: 1.5rem; font-weight: 600; letter-spacing: -0.02em; margin-top: 2px;
    font-variant-numeric: tabular-nums; line-height: 1.15;
  }
  .stat-sub {
    display: block; width: 100%;
    font-size: 0.8rem; color: var(--text-muted); margin-top: 2px; line-height: 1.35;
    overflow: hidden; text-overflow: ellipsis;
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;
  }

  h2 {
    font-size: 1.25rem; font-weight: 600; color: var(--text); margin: 28px 0 14px;
    letter-spacing: -0.02em; display: flex; align-items: center; gap: 12px; flex-wrap: wrap;
  }
  h2::after { display: none; }

  .glass, .card {
    background: var(--surface); border: 1px solid var(--border);
    border-radius: var(--radius); box-shadow: var(--shadow-sm);
  }
  .card { padding: 18px 20px; }
  .card .k { color: var(--text-muted); font-size: 0.82rem; }
  .card .v { font-size: 1.35rem; font-weight: 600; letter-spacing: -0.02em; margin-top: 2px; font-variant-numeric: tabular-nums; }
  .card .d { color: var(--text-secondary); font-size: 0.875rem; margin-top: 4px; }

  .strip { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 12px; }
  .pods { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 12px; }
  .pod {
    cursor: pointer; transition: border-color .15s, box-shadow .15s;
  }
  .pod:hover { border-color: var(--accent); box-shadow: var(--shadow-md); }
  .pod .row { display: flex; align-items: center; gap: 9px; }
  .pod .dot { width: 8px; height: 8px; border-radius: 50%; flex: none; }
  .pod .name { font-weight: 600; font-size: 0.92rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .pod .phase { margin-left: auto; font-size: 0.8rem; color: var(--text-secondary); }
  .pod .meta { display: flex; gap: 12px; flex-wrap: wrap; color: var(--text-muted); font-size: 0.85rem; margin-top: 10px; }
  .pod .meta b { color: var(--text); font-weight: 600; font-variant-numeric: tabular-nums; }
  .pod .restarts-bad { color: var(--status-error); font-weight: 600; }
  .pod .warn { color: var(--status-warn); font-size: 0.85rem; margin-top: 9px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .empty {
    color: var(--text-secondary); padding: 20px; font-size: 0.95rem;
    border: 1px dashed var(--border); border-radius: var(--radius); background: var(--surface-muted);
  }
  .empty code { font-family: var(--font-mono); background: var(--code-bg); padding: 2px 6px; border-radius: 4px; }

  .qa { display: grid; grid-template-columns: minmax(240px, 1fr) minmax(0, 2fr) minmax(240px, 1fr); gap: 14px; }
  @media (max-width: 1280px) { .qa { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 800px) { .qa { grid-template-columns: 1fr; } }

  .acts { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr)); gap: 14px; }
  .act { padding: 18px 20px; }
  .act::before { display: none; }
  .act-title { font-weight: 600; font-size: 1rem; margin-bottom: 12px; letter-spacing: -0.01em; line-height: 1.35; }
  .act-row { display: flex; align-items: center; gap: 10px; margin-bottom: 10px; flex-wrap: wrap; }
  .act-row:last-child { margin-bottom: 0; }

  .run-btn {
    cursor: pointer; padding: 8px 18px; border-radius: 980px; font-size: 0.875rem; font-weight: 500;
    color: var(--text); background: var(--surface); border: 1px solid var(--border); font-family: inherit;
    transition: background .15s, border-color .15s;
  }
  .run-btn:hover:not(:disabled) { border-color: var(--text-muted); background: var(--btn-hover-bg); }
  .run-btn:disabled { opacity: 0.45; cursor: not-allowed; }
  .run-btn.primary { background: var(--accent); border-color: var(--accent); color: #fff; }
  [data-theme="dark"] .run-btn.primary { background: #0071e3; border-color: #0071e3; }
  .run-btn.primary:hover:not(:disabled) { background: var(--accent-hover); border-color: var(--accent-hover); }

  .theme-btn {
    display: inline-flex; align-items: center; justify-content: center;
    width: 34px; height: 34px; padding: 0; border-radius: 50%;
    border: 1px solid var(--border); background: var(--surface);
    color: var(--text-secondary); cursor: pointer; flex: none;
    transition: background 0.15s, border-color 0.15s, color 0.15s;
  }
  .theme-btn:hover { background: var(--hover-bg); color: var(--text); border-color: var(--text-muted); }
  .theme-btn svg { width: 16px; height: 16px; }
  .theme-btn .icon-sun { display: none; }
  .theme-btn .icon-moon { display: block; }
  [data-theme="light"] .theme-btn .icon-sun { display: block; }
  [data-theme="light"] .theme-btn .icon-moon { display: none; }

  .inp {
    background: var(--surface); border: 1px solid var(--border); color: var(--text);
    border-radius: 8px; padding: 8px 12px; font-size: 0.9rem; font-family: inherit; min-height: 2.25rem;
  }
  .inp:focus { outline: none; border-color: var(--accent); box-shadow: 0 0 0 3px var(--focus-ring); }
  .inp.grow { flex: 1; min-width: 120px; }
  textarea.inp { resize: vertical; min-height: 4rem; }
  .chk { display: inline-flex; align-items: center; gap: 7px; font-size: 0.875rem; color: var(--text-secondary); }
  .chk input { accent-color: var(--accent); }

  .dl-btn {
    cursor: pointer; font-size: 0.8rem; padding: 6px 12px; border-radius: 980px;
    color: var(--accent); background: transparent; border: none; font-family: inherit;
  }
  .dl-btn:hover { text-decoration: underline; }
  .rlink { color: var(--accent); text-decoration: none; font-size: 0.875rem; }
  .rlink:hover { text-decoration: underline; }

  .run-status { font-size: 0.875rem; color: var(--text-secondary); display: inline-flex; align-items: center; gap: 6px; }
  .run-status .spin { width: 8px; height: 8px; border-radius: 50%; background: var(--accent); animation: pulse 1.2s infinite; }
  @keyframes pulse { 50% { opacity: 0.35; } }
  .run-status.err { color: var(--status-error); }

  .knowledge-lamp {
    display: inline-flex; align-items: center; gap: 8px; font-size: 0.82rem; color: var(--text-muted);
    padding: 4px 10px; border-radius: 980px; border: 1px solid var(--border); background: var(--surface);
  }
  .knowledge-lamp .kl-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--status-neutral); }
  .knowledge-lamp[data-status="ok"] .kl-dot { background: var(--status-ok); }
  .knowledge-lamp[data-status="degraded"] .kl-dot { background: var(--status-warn); }
  .knowledge-lamp[data-status="offline"] .kl-dot { background: var(--status-error); }

  .ask-layout { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr); gap: 14px; }
  @media (max-width: 980px) { .ask-layout { grid-template-columns: 1fr; } }
  .ask-thread { min-height: 280px; max-height: 440px; overflow-y: auto; display: flex; flex-direction: column; gap: 12px; padding: 4px 2px; }
  .ask-bubble { border: 1px solid var(--border); border-radius: 12px; padding: 12px 14px; background: var(--surface-muted); }
  .ask-bubble.user { border-color: var(--accent-border-soft); background: var(--accent-bg-soft); }
  .ask-bubble.assistant { border-color: var(--border); }
  .ask-bubble.abstain { border-color: rgba(255,149,0,0.45); background: rgba(255,149,0,0.06); }
  .ask-meta { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; margin-bottom: 8px; font-size: 0.82rem; color: var(--text-muted); }
  .ask-badge { display: inline-flex; padding: 2px 8px; border-radius: 980px; font-weight: 600; font-size: 0.72rem; border: 1px solid var(--border); text-transform: uppercase; }
  .ask-badge.high { color: var(--status-ok); }
  .ask-badge.medium { color: var(--status-warn); }
  .ask-badge.low { color: var(--status-error); }
  .ask-answer { white-space: pre-wrap; color: var(--text); font-size: 0.95rem; line-height: 1.55; }
  .ask-answer code { font-family: var(--font-mono); font-size: 0.86em; background: var(--code-bg); padding: 1px 5px; border-radius: 4px; }
  .ask-cites { margin-top: 10px; display: flex; flex-direction: column; gap: 6px; }
  .ask-cite { font-size: 0.85rem; color: var(--text-secondary); padding: 8px 10px; border-radius: 8px; border: 1px solid var(--border); background: var(--surface-muted); }
  .ask-cite a { color: var(--accent); text-decoration: none; }
  .ask-chips { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 8px; }
  .ask-chip { cursor: pointer; border: 1px solid var(--border); background: var(--surface); color: var(--text-secondary); border-radius: 980px; padding: 6px 12px; font-size: 0.82rem; }
  .ask-chip:hover { border-color: var(--accent); color: var(--text); }
  .ask-hint { font-size: 0.82rem; color: var(--text-muted); margin-top: 8px; }

  .runs-table { width: 100%; border-collapse: collapse; }
  .runs-table tr:hover { background: var(--surface-muted); }
  .runs-table td { padding: 10px 12px; border-bottom: 1px solid var(--border); font-size: 0.92rem; color: var(--text-secondary); }
  .runs-table td:first-child { color: var(--text-muted); font-size: 0.85rem; white-space: nowrap; font-variant-numeric: tabular-nums; }
  .chip { display: inline-flex; padding: 3px 10px; border-radius: 980px; font-size: 0.78rem; font-weight: 600; border: 1px solid var(--border); }
  .chip.pass { color: var(--status-ok); border-color: rgba(52,199,89,0.4); background: rgba(52,199,89,0.08); }
  .chip.fail { color: var(--status-error); border-color: rgba(255,59,48,0.35); background: rgba(255,59,48,0.08); }

  .spark-wrap { position: relative; }
  .spark-tip {
    position: absolute; pointer-events: none; display: none; background: var(--surface);
    border: 1px solid var(--border); border-radius: 8px; padding: 6px 12px; font-size: 0.85rem;
    box-shadow: var(--shadow-md); z-index: 2;
  }
  .feed { display: flex; flex-direction: column; max-height: 340px; overflow-y: auto; }
  .feed-item { display: flex; align-items: baseline; gap: 10px; padding: 8px 0; border-bottom: 1px solid var(--border); font-size: 0.875rem; }
  .feed-item:last-child { border-bottom: none; }
  .feed-item .f-when { color: var(--text-muted); white-space: nowrap; font-variant-numeric: tabular-nums; }
  .feed-item .f-kind { font-weight: 600; white-space: nowrap; }
  .feed-item .f-brief { color: var(--text-secondary); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .pod-search { margin-left: 10px; width: min(240px, 40vw); }

  .drawer {
    position: fixed; top: 0; right: 0; bottom: 0; width: min(760px, 94vw);
    background: var(--surface); border-left: 1px solid var(--border);
    box-shadow: -8px 0 32px rgba(0,0,0,0.45); transform: translateX(100%);
    transition: transform .28s var(--ease-out); z-index: 30; display: flex; flex-direction: column;
  }
  .drawer.open { transform: translateX(0); }
  .drawer header { padding: 16px 20px; border-bottom: 1px solid var(--border); display: flex; align-items: center; }
  .drawer header b { font-size: 0.95rem; font-weight: 600; }
  .drawer header .close {
    margin-left: auto; cursor: pointer; color: var(--text-secondary); background: var(--surface-muted);
    border: 1px solid var(--border); border-radius: 50%; width: 32px; height: 32px; font-size: 15px;
  }
  .drawer pre { flex: 1; overflow: auto; margin: 0; padding: 16px 20px; font-family: var(--font-mono); font-size: 0.85rem; line-height: 1.65; color: var(--text-secondary); white-space: pre-wrap; }
  .drawer-controls { display: flex; align-items: center; gap: 8px; padding: 10px 18px; border-bottom: 1px solid var(--border); flex-wrap: wrap; }

  #job-live {
    padding: 0; overflow: hidden;
    border: 1px solid #2c2c2e; border-radius: 10px;
    box-shadow: 0 16px 48px rgba(0,0,0,0.22), 0 0 0 1px rgba(255,255,255,0.04) inset;
    background: #0d0d0d;
  }
  .terminal-chrome {
    display: flex; align-items: center; gap: 12px;
    padding: 11px 14px;
    background: linear-gradient(180deg, #454547 0%, #38383a 100%);
    border-bottom: 1px solid #1c1c1e;
  }
  .terminal-lights { display: flex; align-items: center; gap: 7px; flex: none; }
  .terminal-lights span {
    width: 12px; height: 12px; border-radius: 50%;
    box-shadow: inset 0 0 0 1px rgba(0,0,0,0.12);
  }
  .tl-red { background: #ff5f57; }
  .tl-yellow { background: #febc2e; }
  .tl-green { background: #28c840; }
  .terminal-title {
    flex: 1; min-width: 0; text-align: center;
    font-size: 0.78rem; font-weight: 500; color: #b0b0b5;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  .terminal-title .spin {
    display: inline-block; width: 7px; height: 7px; border-radius: 50%;
    background: #28c840; box-shadow: 0 0 8px rgba(40,200,64,0.8);
    animation: pulse 1.2s infinite; margin-right: 6px; vertical-align: middle;
  }
  .terminal-actions { display: flex; align-items: center; gap: 6px; flex: none; }
  .term-btn {
    cursor: pointer; font-size: 0.72rem; font-weight: 500; letter-spacing: 0.01em;
    padding: 4px 10px; border-radius: 6px; font-family: inherit;
    border: 1px solid rgba(255,255,255,0.12); background: rgba(255,255,255,0.08);
    color: #d1d1d6; transition: background 0.15s, border-color 0.15s;
  }
  .term-btn:hover { background: rgba(255,255,255,0.14); border-color: rgba(255,255,255,0.2); color: #fff; }
  .term-btn.danger { color: #ff8a80; border-color: rgba(255,95,87,0.35); background: rgba(255,95,87,0.12); }
  .term-btn.danger:hover { background: rgba(255,95,87,0.22); color: #ffcbc7; }
  .terminal-body { background: #0d0d0d; }
  #live-cases {
    display: flex; flex-wrap: wrap; gap: 6px 10px;
    padding: 10px 14px; margin: 0;
    border-bottom: 1px solid #1f1f1f;
    background: #121212;
  }
  #live-cases:empty { display: none; padding: 0; border: none; }
  #live-log {
    font-family: "SF Mono", ui-monospace, Menlo, Monaco, "Cascadia Code", monospace;
    font-size: 0.8125rem; line-height: 1.6; max-height: 340px; overflow-y: auto;
    background: #0d0d0d; color: #d1d1d6;
    padding: 14px 16px 16px; margin: 0;
    white-space: pre-wrap; word-break: break-word;
    border: none; border-radius: 0;
    tab-size: 4;
  }
  #live-log::before {
    content: "$ argus run --live";
    display: block; color: #32d74b; margin-bottom: 10px;
    font-weight: 600;
  }
  #live-log::after {
    content: "█";
    display: inline-block; color: #32d74b; animation: term-blink 1s step-end infinite;
    margin-left: 2px;
  }
  @keyframes term-blink { 50% { opacity: 0; } }
  #live-log.is-idle::after { display: none; }
  #live-log .tl-dim, .terminal-log-snippet .tl-dim { color: #636366; }
  #live-log .tl-green, .terminal-log-snippet .tl-green { color: #32d74b; }
  #live-log .tl-red, .terminal-log-snippet .tl-red { color: #ff453a; }
  #live-log .tl-yellow, .terminal-log-snippet .tl-yellow { color: #ffd60a; }
  #live-log .tl-orange, .terminal-log-snippet .tl-orange { color: #ff9f0a; }
  #live-log .tl-cyan, .terminal-log-snippet .tl-cyan { color: #64d2ff; }
  #live-log .tl-blue, .terminal-log-snippet .tl-blue { color: #0a84ff; }
  #live-log .tl-magenta, .terminal-log-snippet .tl-magenta { color: #bf5af2; }
  #live-log .tl-white, .terminal-log-snippet .tl-white { color: #f5f5f7; }
  #live-log .tl-line.l-success, .terminal-log-snippet .tl-line.l-success { color: #32d74b; }
  #live-log .tl-line.l-error, .terminal-log-snippet .tl-line.l-error { color: #ff453a; }
  #live-log .tl-line.l-warn, .terminal-log-snippet .tl-line.l-warn { color: #ffd60a; }
  #live-log .tl-line.l-info, .terminal-log-snippet .tl-line.l-info { color: #64d2ff; }
  #live-log .tl-line.l-muted, .terminal-log-snippet .tl-line.l-muted { color: #98989d; }
  #live-log .tl-line.l-accent, .terminal-log-snippet .tl-line.l-accent { color: #bf5af2; }
  #live-log .tl-line.l-white, .terminal-log-snippet .tl-line.l-white { color: #f5f5f7; }
  #live-log .tl-bold, .terminal-log-snippet .tl-bold { font-weight: 700; }
  #live-log .tl-line, .terminal-log-snippet .tl-line { display: block; }
  .terminal-log-snippet {
    margin: 10px 0 0; padding: 12px 14px; border-radius: 8px;
    font-family: "SF Mono", ui-monospace, Menlo, monospace;
    font-size: 0.8rem; line-height: 1.55; max-height: 200px; overflow-y: auto;
    background: #0d0d0d; border: 1px solid #2c2c2e; white-space: pre-wrap;
  }
  .livecase {
    display: inline-flex; align-items: center; gap: 5px;
    font-family: "SF Mono", ui-monospace, Menlo, monospace;
    font-size: 0.75rem; padding: 3px 8px; border-radius: 4px;
    background: rgba(255,255,255,0.05); border: 1px solid #2a2a2a;
  }
  .livecase .dot { width: 6px; height: 6px; border-radius: 50%; flex: none; }
  .livecase.pass { color: #7dcea0; border-color: rgba(40,200,64,0.25); }
  .livecase.pass .dot { background: #28c840; }
  .livecase.fail { color: #ff8a80; border-color: rgba(255,95,87,0.3); background: rgba(255,95,87,0.08); }
  .livecase.fail .dot { background: #ff5f57; }
  #live-tally .pass { color: #28c840; }
  #live-tally .fail { color: #ff5f57; }
  .terminal-title .d { color: #8e8e93; }
  #live-log::-webkit-scrollbar { width: 8px; }
  #live-log::-webkit-scrollbar-thumb { background: #3a3a3c; border-radius: 4px; }
  #live-log::-webkit-scrollbar-track { background: transparent; }
  .err-summary { border: 1px solid rgba(255,59,48,0.35); background: rgba(255,59,48,0.06); border-radius: 12px; padding: 14px 16px; margin: 10px 0; }
  .result-title { font-weight: 600; font-size: 1rem; margin-bottom: 10px; display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
  .result-files { font-family: var(--font-mono); font-size: 0.85rem; color: var(--text-secondary); line-height: 1.7; }
  .result-err { color: var(--status-error); }

  #toasts { position: fixed; top: 18px; right: 18px; z-index: 50; display: flex; flex-direction: column; gap: 10px; }
  .toast {
    background: var(--surface); border: 1px solid var(--border); border-radius: 12px;
    padding: 12px 18px; box-shadow: var(--shadow-md); font-size: 0.95rem;
    display: flex; align-items: center; gap: 10px; min-width: 260px;
  }
  .toast.ok { border-left: 3px solid var(--status-ok); }
  .toast.bad { border-left: 3px solid var(--status-error); }
  .toast .t-sub { color: var(--text-secondary); font-size: 0.85rem; }

  #palette {
    position: fixed; inset: 0; z-index: 55; background: var(--palette-overlay);
    backdrop-filter: blur(4px); display: flex; align-items: flex-start; justify-content: center; padding-top: 12vh;
  }
  .palette-box { width: min(680px, 94vw); border-radius: 16px; padding: 14px; background: var(--surface); box-shadow: 0 24px 64px rgba(0,0,0,0.55); border: 1px solid var(--border); }
  #palette-input { width: 100%; font-size: 1.05rem; padding: 14px 16px; margin-bottom: 8px; border: 1px solid var(--border); border-radius: 10px; }
  .palette-item { padding: 12px 14px; border-radius: 8px; cursor: pointer; display: flex; align-items: center; gap: 10px; font-size: 1rem; }
  .palette-item.sel { background: var(--accent-soft); }
  .palette-item .pk { color: var(--text-muted); margin-left: auto; font-size: 0.8rem; }

  .status-bar {
    padding: 12px 32px; border-top: 1px solid var(--border); background: var(--surface);
    color: var(--text-muted); font-size: 0.85rem; display: flex; gap: 14px; flex-wrap: wrap; align-items: center;
  }
  kbd { border: 1px solid var(--border); border-radius: 4px; padding: 1px 6px; font-size: 0.78rem; font-family: var(--font-mono); background: var(--surface-muted); }

  .rail-overlay { display: none; position: fixed; inset: 0; background: var(--overlay-bg); z-index: 19; }
  body.rail-open .rail-overlay { display: block; }
  body.rail-open .side-rail { box-shadow: 4px 0 24px rgba(0,0,0,0.12); }

  @media (max-width: 980px) {
    .side-rail { transform: translateX(-100%); transition: transform .28s var(--ease-out); }
    body.rail-open .side-rail { transform: translateX(0); }
    .main-column { margin-left: 0; }
    body.rail-collapsed .main-column { margin-left: 0; }
    body.rail-open.rail-collapsed .side-rail { width: var(--rail-width); }
    body.rail-open.rail-collapsed .rail-brand .mark-word,
    body.rail-open.rail-collapsed .rail-brand strong,
    body.rail-open.rail-collapsed .rail-group-label,
    body.rail-open.rail-collapsed .rail-link-label,
    body.rail-open.rail-collapsed .rail-collapse-label { display: inline; }
    body.rail-open.rail-collapsed .rail-link { justify-content: flex-start; }
    body.rail-open.rail-collapsed .rail-collapse { justify-content: flex-start; }
    .menu-btn { display: inline-flex; }
    .header-mark { display: inline-flex; }
    .panel-viewport { padding: 16px 18px 24px; }
    .global-header { padding: 12px 18px; }
    .status-bar { padding: 12px 18px; }
  }

  .skip-link { position: absolute; left: 12px; top: -48px; z-index: 10000; padding: 10px 16px; border-radius: 8px; background: var(--accent); color: #fff; font-weight: 600; text-decoration: none; }
  .skip-link:focus { top: 12px; }
  #main-content:focus { outline: none; }
  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after { animation-duration: 0.01ms !important; transition-duration: 0.01ms !important; }
    .panel { animation: none; }
  }
</style>
</head>
<body>
<a class="skip-link" href="#main-content">Skip to main content</a>

<div class="rail-overlay" id="rail-overlay" aria-hidden="true"></div>
<div class="app">
<aside class="side-rail" aria-label="Mission Control navigation">
  <div class="rail-brand">
    <a class="zyvor-mark" href="https://zyvor.dev/" target="_blank" rel="noopener noreferrer" aria-label="Zyvor home">
      <svg class="mark-z" width="18" height="18" viewBox="0 0 18 18" aria-hidden="true">
        <path d="M2 2h14L6.6 16H16" fill="none" stroke="#ff5a15" stroke-width="2.6" stroke-linejoin="round" stroke-linecap="round"/>
      </svg>
      <span class="mark-word">zyvor</span>
    </a>
    <strong>Mission Control</strong>
  </div>
  <nav class="rail-nav">
    <div class="rail-group">
      <div class="rail-group-label">Console</div>
      <button type="button" class="rail-link is-active" data-panel="overview" title="Overview">
        <svg class="rail-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="1.5" y="1.5" width="5.5" height="5.5" rx="1"/><rect x="9" y="1.5" width="5.5" height="5.5" rx="1"/><rect x="1.5" y="9" width="5.5" height="5.5" rx="1"/><rect x="9" y="9" width="5.5" height="5.5" rx="1"/></svg>
        <span class="rail-link-label">Overview</span>
      </button>
      <button type="button" class="rail-link" data-panel="ask" title="Ask Zyra">
        <svg class="rail-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2.5 3.5h11v7H6.2L3.5 13V3.5z"/><path d="M5.5 6.5h5M5.5 9h3"/></svg>
        <span class="rail-link-label">Ask Zyra</span>
      </button>
    </div>
    <div class="rail-group">
      <div class="rail-group-label">Testing</div>
      <button type="button" class="rail-link" data-panel="pipeline" title="Pipeline">
        <svg class="rail-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="3,2 13,8 3,14"/></svg>
        <span class="rail-link-label">Pipeline</span>
      </button>
      <button type="button" class="rail-link" data-panel="visual" title="Visual">
        <svg class="rail-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M1.5 8s2.5-4.5 6.5-4.5 6.5 4.5 6.5 4.5-2.5 4.5-6.5 4.5S1.5 8 1.5 8z"/><circle cx="8" cy="8" r="2"/></svg>
        <span class="rail-link-label">Visual</span>
      </button>
      <button type="button" class="rail-link" data-panel="quality" title="Quality">
        <svg class="rail-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 1.5l6 3v4c0 3.5-2.5 5.5-6 6.5-3.5-1-6-3-6-6.5v-4l6-3z"/><path d="M5.5 8l1.8 1.8L10.5 6.5"/></svg>
        <span class="rail-link-label">Quality</span>
      </button>
      <button type="button" class="rail-link" data-panel="journeys" title="Journeys">
        <svg class="rail-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="3" cy="12" r="1.5"/><circle cx="13" cy="4" r="1.5"/><path d="M4.2 11.2 9.5 6.8l2.3 2.3 2.5-2.5"/></svg>
        <span class="rail-link-label">Journeys</span>
      </button>
      <button type="button" class="rail-link" data-panel="api" title="API">
        <svg class="rail-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 5.5h6v5H5z"/><path d="M2.5 8h2M11.5 8h2M8 2.5v2M8 11.5v2"/></svg>
        <span class="rail-link-label">API</span>
      </button>
      <button type="button" class="rail-link" data-panel="probes" title="Probes">
        <svg class="rail-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="8" cy="8" r="2"/><path d="M8 1.5v2M8 12.5v2M1.5 8h2M12.5 8h2M3.4 3.4l1.4 1.4M11.2 11.2l1.4 1.4M3.4 12.6l1.4-1.4M11.2 4.8l1.4-1.4"/></svg>
        <span class="rail-link-label">Probes</span>
      </button>
      <button type="button" class="rail-link" data-panel="requirements" title="Requirements">
        <svg class="rail-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2.5" y="1.5" width="11" height="13" rx="1"/><path d="M5 5h6M5 8h6M5 11h3.5"/></svg>
        <span class="rail-link-label">Requirements</span>
      </button>
    </div>
    <div class="rail-group">
      <div class="rail-group-label">Security</div>
      <button type="button" class="rail-link" data-panel="security" title="Security testing">
        <svg class="rail-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="7" width="10" height="7.5" rx="1"/><path d="M5.5 7V5a3.5 3.5 0 0 1 5 0v2"/></svg>
        <span class="rail-link-label">Security testing</span>
      </button>
    </div>
    <div class="rail-group">
      <div class="rail-group-label">Operations</div>
      <button type="button" class="rail-link" data-panel="operations" title="Runs &amp; schedules">
        <svg class="rail-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="8" cy="8" r="6"/><path d="M8 4.5V8l2.5 2.5"/><path d="M12.5 2.5l-1 1"/></svg>
        <span class="rail-link-label">Runs &amp; schedules</span>
      </button>
    </div>
  </nav>
  <div class="rail-footer">
    <button type="button" class="rail-collapse" id="rail-collapse" aria-label="Collapse sidebar" title="Collapse sidebar">
      <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 3 5 8l5 5"/></svg>
      <span class="rail-collapse-label">Collapse</span>
    </button>
  </div>
</aside>
<div class="main-column" id="main-content" tabindex="-1">
<header class="global-header">
  <button type="button" class="menu-btn" id="menu-btn" aria-label="Open navigation">☰</button>
  <a class="zyvor-mark header-mark" href="https://zyvor.dev/" target="_blank" rel="noopener noreferrer" aria-label="Zyvor home">
    <svg class="mark-z" width="18" height="18" viewBox="0 0 18 18" aria-hidden="true">
      <path d="M2 2h14L6.6 16H16" fill="none" stroke="#ff5a15" stroke-width="2.6" stroke-linejoin="round" stroke-linecap="round"/>
    </svg>
    <span class="mark-word">zyvor</span>
  </a>
  <div class="global-header-spacer"></div>
  <span class="knowledge-lamp" id="knowledge-lamp" data-status="offline" title="Knowledge agent status">
    <span class="kl-dot" aria-hidden="true"></span>
    <span id="knowledge-lamp-label">Knowledge offline</span>
  </span>
  <button type="button" class="theme-btn" id="theme-toggle" aria-label="Switch to light theme" title="Switch to light theme">
    <svg class="icon-moon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7.5 1.5a6 6 0 1 0 6 6 4.5 4.5 0 0 1-6-6z"/></svg>
    <svg class="icon-sun" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="8" cy="8" r="3"/><path d="M8 1.5v1.5M8 13v1.5M1.5 8H3M13 8h1.5M3.05 3.05l1.06 1.06M11.9 11.9l1.06 1.06M3.05 12.95l1.06-1.06M11.9 4.1l1.06-1.06"/></svg>
  </button>
  <button type="button" class="run-btn primary" id="topbar-palette">Search</button>
</header>
<div class="panel-viewport">

<section id="panel-overview" class="panel is-active">
  <div class="hero" data-status="offline" id="hero">
    <div class="hero-shine" aria-hidden="true"></div>
    <div class="hero-head">
      <div class="icon-badge" aria-hidden="true">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/>
        </svg>
      </div>
      <div>
        <div class="brand-eyebrow">ZYVOR ARGUS · MISSION CONTROL</div>
        <h1><span id="banner-title">STANDBY</span></h1>
        <div class="subtitle status-line"><span class="lamp"></span><span id="banner-sub">waiting for first sync</span></div>
      </div>
      <span class="sync" style="display:flex;flex-direction:column;align-items:flex-end;gap:4px">
        <span id="sync">connecting…</span>
        <span id="session" style="display:none">🔐 <b id="session-user"></b> · <a class="rlink" href="#" id="logout">sign out</a></span>
      </span>
    </div>
    <div class="stat-grid">
      <div class="stat-tile"{% if desktop_mode %} style="display:none"{% endif %}><span class="stat-label">Pods</span><span class="stat-value" id="stat-pods">—</span><span class="stat-sub" id="stat-pods-sub"></span></div>
      <div class="stat-tile"{% if desktop_mode %} style="display:none"{% endif %}><span class="stat-label">Replicas</span><span class="stat-value" id="stat-replicas">—</span><span class="stat-sub" id="stat-replicas-sub"></span></div>
      <div class="stat-tile"><span class="stat-label">Last QA run</span><span class="stat-value" id="stat-run">—</span><span class="stat-sub" id="stat-run-sub"></span></div>
      <div class="stat-tile"><span class="stat-label">Pass rate</span><span class="stat-value" id="stat-rate">—</span><span class="stat-sub" id="stat-rate-sub">last 30 runs</span></div>
