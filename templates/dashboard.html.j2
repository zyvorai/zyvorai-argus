  redirects: "redirect chain", headers: "HTTP headers", cookies: "cookie audit", robots: "robots/sitemap",
  security_paths: "exposed paths", api_check: "API check", sitemap_test: "sitemap URLs", dns_records: "DNS records",
  cors: "CORS check", transport: "compression", flow: "flow test", route_sweep: "route sweep",
  api_contract: "API contract", api_contract_diff: "API contract diff", contract_verify: "contract verify",
  auth_test: "auth & session", realtime: "live data", vitals: "web vitals", ai_flow: "AI test",
  har_replay: "HAR record/replay", import_codegen: "import codegen",
  misconfig_scan: "misconfig scan", cve_lookup: "CVE lookup", sca_scan: "SCA scan", llm_redteam: "LLM red-team",
  exploit_poc: "exploit PoC", attack_chain: "attack chain", host_pentest: "host pentest", cloud_pentest: "cloud pentest",
  db_assert: "DB assert", chaos_inject: "chaos inject", chaos_webhook: "chaos webhook",
  port_scan: "port scan", tls_cipher_scan: "TLS cipher scan", dast_scan: "DAST scan",
