        + ' <span class="chip" style="color:' + scoreColor(v.quality_score) + '">score ' + (v.quality_score != null ? Math.round(v.quality_score) : "—") + "</span></div>"
        + (tests.length
            ? '<div class="d" style="margin-top:4px">generated tests: ' + tests.map((t) => "<code>" + esc(t) + "</code>").join(", ") + "</div>"
            : "")
        + "</div>";
    }).join("");
    body.innerHTML = '<div class="d">' + esc(detail.source_type || "") + (detail.origin_id ? " · " + esc(detail.origin_id) : "") + "</div>"
      + '<div style="margin-top:10px"><b>Description</b><div class="d" style="white-space:pre-wrap;margin-top:2px">' + esc((detail.content && detail.content.description) || "") + "</div></div>"
      + '<div style="margin-top:10px"><b>Quality issues</b>' + issuesHtml + "</div>"
      + '<div style="margin-top:10px"><b>Version history</b>' + (versionsHtml || '<span class="d">none</span>') + "</div>";
