}

/* findings — the developer-facing "what's broken" list */
const SEV_COLOR = { critical: "var(--status-error)", high: "var(--status-error)", medium: "var(--status-warn)", low: "var(--accent-2)", info: "var(--label-secondary)" };
async function loadFindings() {
  try {
    const data = await fetch("/api/dashboard/findings?limit=200").then((r) => r.json());
    const el = $("findings"), counts = $("find-counts");
    const c = data.counts || {};
    counts.innerHTML = ["critical", "high", "medium", "low"].filter((s) => c[s])
      .map((s) => '<span style="color:' + SEV_COLOR[s] + '">' + c[s] + " " + s + "</span>").join(" · ") || "";
    if (!data.findings || !data.findings.length) {
      el.innerHTML = '<span class="d">No findings yet — run API-contract, auth, live-data, vitals or audit and issues will collect here.</span>';
      return;
    }
    el.innerHTML = '<div style="overflow-x:auto"><table class="runs-table"><tbody>'
      + "<tr><th>severity</th><th>source</th><th>what's broken</th><th>detail</th><th>where</th><th>when</th></tr>"
      + data.findings.map((f) => "<tr>"
        + '<td><span class="chip" style="color:' + (SEV_COLOR[f.severity] || "") + '">' + esc(f.severity) + "</span></td>"
        + '<td class="d">' + esc(KIND_LABELS[f.source] || f.source) + "</td>"
        + "<td>" + esc(f.title) + (f.url ? ' <span class="d">· ' + esc(f.url) + "</span>" : "") + "</td>"
        + '<td class="d" style="max-width:340px">' + esc(f.detail || "") + "</td>"
        + '<td class="d"><code>' + esc(f.where || "") + "</code></td>"
        + '<td class="d">' + relIso(f.at) + "</td></tr>").join("")
      + "</tbody></table></div>";
  } catch (e) { /* offline */ }
}
$("find-clear").addEventListener("click", async () => {
  await fetch("/api/dashboard/findings", { method: "DELETE" });
  loadFindings();
});

async function loadEngagements() {
  try {
    const data = await fetch("/api/v2/engagements").then((r) => r.json());
    const list = data.engagements || [];
    const el = $("engagements");
    if (!list.length) {
      el.innerHTML = '<span class="d">No engagements yet — create one above to unlock the cards below.</span>';
    } else {
      el.innerHTML = '<div style="overflow-x:auto"><table class="runs-table"><tbody>'
        + "<tr><th>target</th><th>tier</th><th>scope</th><th>status</th><th></th></tr>"
        + list.map((e) => "<tr><td><code>" + esc(e.target_pattern) + "</code></td><td class=\"d\">" + esc(e.tier) + "</td>"
          + '<td class="d" style="max-width:260px">' + esc(e.scope_statement) + "</td>"
          + "<td>" + (e.revoked_at ? '<span class="chip fail">revoked</span>' : '<span class="chip pass">active</span>') + "</td>"
          + "<td>" + (e.revoked_at ? "" : '<button class="dl-btn eng-revoke" data-id="' + esc(e.id) + '">revoke</button>') + "</td></tr>").join("")
        + "</tbody></table></div>";
      for (const btn of el.querySelectorAll(".eng-revoke")) {
        btn.addEventListener("click", async () => {
          if (!confirm("Revoke this engagement? Jobs citing it will be rejected.")) return;
          await fetch("/api/v2/engagements/" + encodeURIComponent(btn.dataset.id), { method: "DELETE" });
          loadEngagements();
        });
      }
    }
    const active = list.filter((e) => !e.revoked_at);
    const options = '<option value="">— select an authorized engagement —</option>'
      + active.map((e) => '<option value="' + esc(e.id) + '">' + esc(e.target_pattern) + " (" + esc(e.tier) + ")</option>").join("");
    for (const sel of document.querySelectorAll(".eng-select")) {
      const prev = sel.value;
      sel.innerHTML = options;
      if (active.some((e) => e.id === prev)) sel.value = prev;
    }
  } catch (e) { /* offline */ }
}
$("eng-create").addEventListener("click", async () => {
  const target_pattern = $("eng-pattern").value.trim();
  const scope_statement = $("eng-scope").value.trim();
  if (!target_pattern || !scope_statement) { toast("engagement", false, "target pattern and scope statement are required"); return; }
  const res = await fetch("/api/v2/engagements", {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({ target_pattern, scope_statement, tier: "active_recon" }),
  });
  if (!res.ok) {
    const d = await res.json().catch(() => ({}));
    toast("engagement", false, String(d.detail || "failed to create engagement"));
    return;
  }
  $("eng-pattern").value = "";
  $("eng-scope").value = "";
  toast("engagement", true, "engagement created");
  loadEngagements();
});

/* Requirements — versioned requirement store (read-only; written by the
   pipeline's fetch -> parse -> evaluate_quality chain). */
function scoreColor(score) {
  if (score == null) return "";
  if (score >= 80) return "#3ecf6b";
  if (score >= 60) return "#e0b32a";
  return "#f05a5a";
}
async function loadRequirements() {
  try {
    const data = await fetch("/api/v2/requirements").then((r) => r.json());
    const list = data.requirements || [];
    $("req-count").textContent = list.length ? list.length + " tracked" : "";
    const el = $("requirements");
    if (!list.length) {
