<script>
"use strict";

// Attach X-CSRF-Token to every mutating same-origin fetch() automatically,
// so none of the call sites below need to be touched individually. The
// token is read from the (non-HttpOnly) zyvor_qa_csrf cookie set alongside
// the session cookie at login; see orchestrator/dashboard/auth.py.
(function () {
  const realFetch = window.fetch.bind(window);
  window.fetch = function (input, init) {
    const method = ((init && init.method) || "GET").toUpperCase();
    if (method !== "GET" && method !== "HEAD") {
      const match = document.cookie.match(/(?:^|;\s*)zyvor_qa_csrf=([^;]+)/);
      if (match) {
        init = init || {};
        init.headers = Object.assign({}, init.headers, {"X-CSRF-Token": match[1]});
      }
    }
    return realFetch(input, init);
  };
})();

const REFRESH = {{ refresh_interval_ms }};
const $ = (id) => document.getElementById(id);

/* Side-rail collapse (icons-only) */
function applyRailCollapsed(collapsed) {
  document.body.classList.toggle("rail-collapsed", collapsed);
  var btn = $("rail-collapse");
  if (btn) {
    btn.setAttribute("aria-label", collapsed ? "Expand sidebar" : "Collapse sidebar");
    btn.title = collapsed ? "Expand sidebar" : "Collapse sidebar";
    var lbl = btn.querySelector(".rail-collapse-label");
    if (lbl) lbl.textContent = collapsed ? "Expand" : "Collapse";
  }
}
function toggleRailCollapsed() {
  var next = !document.body.classList.contains("rail-collapsed");
  localStorage.setItem("zyvor-rail-collapsed", next ? "1" : "0");
  applyRailCollapsed(next);
}
if (localStorage.getItem("zyvor-rail-collapsed") === "1") applyRailCollapsed(true);
$("rail-collapse")?.addEventListener("click", toggleRailCollapsed);

/* Theme toggle (dark default, Apple-style) */
function applyTheme(theme, persist) {
  theme = theme === "light" ? "light" : "dark";
  document.documentElement.setAttribute("data-theme", theme);
  if (persist) { try { localStorage.setItem("zyvor-theme", theme); } catch (e) {} }
  var btn = $("theme-toggle");
  if (btn) {
    var label = theme === "dark" ? "Switch to light theme" : "Switch to dark theme";
    btn.setAttribute("aria-label", label);
    btn.title = label;
  }
}
function toggleTheme() {
  var next = document.documentElement.getAttribute("data-theme") === "light" ? "dark" : "light";
  applyTheme(next, true);
}
$("theme-toggle")?.addEventListener("click", toggleTheme);
applyTheme(document.documentElement.getAttribute("data-theme") || "dark", false);

/* Side-rail panel navigation */
const PANELS = ["overview", "pipeline", "visual", "quality", "probes", "requirements", "journeys", "api", "security", "operations", "ask"];
const PANEL_FOR_KIND = {
  smoke: "pipeline", full: "pipeline", generate: "pipeline", discover: "pipeline", create: "pipeline",
  regression: "visual", compare: "visual", screenshot: "visual", route_sweep: "visual",
  audit: "quality", flaky: "quality", vitals: "quality", crawl_test: "quality",
  ping: "probes", loadtest: "probes", tls: "probes",
  redirects: "probes", headers: "probes", cookies: "probes", robots: "probes",
  security_paths: "probes", api_check: "probes", sitemap_test: "probes", dns_records: "probes",
  cors: "probes", transport: "probes",
  flow: "journeys", har_replay: "journeys", import_codegen: "journeys", ai_flow: "journeys",
  api_contract: "api", realtime: "api", auth_test: "api",
  misconfig_scan: "security", cve_lookup: "security", llm_redteam: "security",
  exploit_poc: "security", attack_chain: "security", host_pentest: "security", cloud_pentest: "security",
  db_assert: "security", chaos_inject: "security", chaos_webhook: "security",
};
function showPanel(id, opts) {
  opts = opts || {};
  if (!PANELS.includes(id)) id = "overview";
  PANELS.forEach(function (p) {
    var el = $("panel-" + p);
    if (el) el.classList.toggle("is-active", p === id);
  });
  document.querySelectorAll(".side-rail [data-panel]").forEach(function (el) {
    var active = el.dataset.panel === id;
    el.classList.toggle("is-active", active);
    if (active) el.setAttribute("aria-current", "page"); else el.removeAttribute("aria-current");
  });
  if (location.hash.slice(1) !== id) history.replaceState(null, "", "#" + id);
  document.body.classList.remove("rail-open");
  if (opts.scrollTarget) {
    var t = document.getElementById(opts.scrollTarget);
    if (t) t.scrollIntoView({ behavior: "smooth", block: "start" });
  }
}
document.querySelectorAll(".side-rail [data-panel]").forEach(function (btn) {
  btn.addEventListener("click", function () { showPanel(btn.dataset.panel); });
});
$("menu-btn")?.addEventListener("click", function () { document.body.classList.toggle("rail-open"); });
$("rail-overlay")?.addEventListener("click", function () { document.body.classList.remove("rail-open"); });
window.addEventListener("hashchange", function () {
