        <input class="inp" id="dba-timeout" type="number" value="30" min="5" max="120" style="width:90px" title="sandbox timeout (s)">
      </div>
      <div class="act-row"><textarea class="inp grow" id="dba-query" rows="2" placeholder="SELECT ... (SELECT-only, enforced server-side)"></textarea></div>
      <div class="act-row">
        <input class="inp grow" id="dba-query-params" placeholder='query bind params as a JSON array, e.g. ["ord_123"] (optional)'>
      </div>
      <div class="act-row" style="gap:10px">
        <select class="inp" id="dba-mode" style="max-width:150px">
          <option value="row_count">row_count</option>
          <option value="cell_equals">cell_equals</option>
          <option value="column_values">column_values</option>
        </select>
        <select class="inp" id="dba-op" style="max-width:100px">
          <option value="==">==</option>
          <option value="!=">!=</option>
          <option value=">">&gt;</option>
          <option value=">=">&gt;=</option>
          <option value="<">&lt;</option>
          <option value="<=">&lt;=</option>
          <option value="all_equal">all_equal</option>
        </select>
