/* sound cue on finish — rising tone on green, falling on red (mutable) */
function beep(ok) {
  if (!soundOn) return;
  try {
    const ctx = new (window.AudioContext || window.webkitAudioContext)();
    const o = ctx.createOscillator(), g = ctx.createGain();
    o.connect(g); g.connect(ctx.destination);
    o.type = "sine";
    const t = ctx.currentTime;
    o.frequency.setValueAtTime(ok ? 520 : 400, t);
    o.frequency.exponentialRampToValueAtTime(ok ? 780 : 240, t + 0.18);
    g.gain.setValueAtTime(0.14, t);
    g.gain.exponentialRampToValueAtTime(0.001, t + 0.35);
    o.start(t); o.stop(t + 0.36);
  } catch (e) { /* audio unavailable */ }
}

document.addEventListener("keydown", (ev) => {
  if ((ev.metaKey || ev.ctrlKey) && ev.key.toLowerCase() === "k") { ev.preventDefault(); openPalette(); return; }
  if (ev.key === "Escape") { closeDrawer(); closePalette(); }
  if (ev.key === "r" && !ev.metaKey && !ev.ctrlKey && !/INPUT|TEXTAREA|SELECT/.test(document.activeElement.tagName)) sync();
});
$("logout").addEventListener("click", async (ev) => {
  ev.preventDefault();
  await fetch("/api/logout", { method: "POST" });
  location.href = "/login";
});

/* chaos_inject/chaos_webhook share the same control-test param shape */
function buildChaosControlParams(controlKind, descText) {
  if (controlKind === "smoke") {
    const params = {};
    if (descText) params.grep = descText;
    return params;
  }
  return { description: descText, record: false };
}

/* job triggers — every CLI capability, online */
function jobParams(kind) {
  if (kind === "smoke") return {
    grep: ($("sm-grep") && $("sm-grep").value.trim()) || "",
    shard: ($("sm-shard") && $("sm-shard").value.trim()) || "",
  };
  if (kind === "full") return {
    source: $("run-source").value,
    spec: $("run-spec").value.trim(),
    pr_number: $("run-pr").value ? parseInt($("run-pr").value, 10) : null,
    expand_coverage: $("run-coverage").checked,
  };
  if (kind === "generate") return {
    source: $("gen-source").value,
    spec: $("gen-spec").value.trim(),
    expand_coverage: $("gen-coverage").checked,
  };
  if (kind === "discover") return { source: $("disc-source").value };
  if (kind === "create") return { description: $("nl-desc").value.trim(), execute: $("nl-execute").checked };
  if (kind === "regression") return { update_baselines: $("reg-update").checked };
  if (kind === "crawl_test") return {
    url: $("ct-url").value.trim(),
    username: $("ct-user").value.trim(),
    password: $("ct-pass").value,
    insecure: $("ct-insecure").checked,
    max_pages: parseInt($("ct-pages").value, 10) || 30,
  };
  if (kind === "audit") return {
    url: $("au-url").value.trim(),
    max_pages: parseInt($("au-pages").value, 10) || 10,
    insecure: $("au-insecure").checked,
    checks: Array.from(document.querySelectorAll("#au-checks input:checked")).map((c) => c.value),
  };
  if (kind === "flaky") return { runs: parseInt($("fl-runs").value, 10) || 3, target: "manual" };
  if (kind === "screenshot") return {
    url: $("sh-url").value.trim(),
    viewports: Array.from(document.querySelectorAll("#sh-vps input:checked")).map((c) => c.value).filter((v) => v !== "on"),
    full_page: $("sh-full").checked,
  };
  if (kind === "compare") return { url_a: $("cmp-a").value.trim(), url_b: $("cmp-b").value.trim(), insecure: $("cmp-insecure").checked };
  if (kind === "ping") return { urls: $("pg-urls").value };
  if (kind === "loadtest") return { url: $("lt-url").value.trim(), requests: parseInt($("lt-n").value, 10) || 100, concurrency: parseInt($("lt-c").value, 10) || 10 };
  if (kind === "tls") return { host: $("tls-host").value.trim() };
  if (kind === "flow") return {
    url: $("fw-url").value.trim(),
    description: $("fw-desc").value,
    username: $("fw-user").value.trim(),
    password: $("fw-pass").value,
    session: $("fw-session").value.trim(),
    browser: $("fw-browser").value,
    device: $("fw-device").value,
    throttle: $("fw-throttle").value,
    insecure: $("fw-insecure").checked,
    record: $("fw-record").checked,
  };
  if (kind === "ai_flow") return {
    url: $("ai-url").value.trim(),
    goal: $("ai-goal").value.trim(),
    session: $("ai-session").value.trim(),
    max_steps: parseInt($("ai-steps").value, 10) || 20,
    insecure: $("ai-insecure").checked,
  };
  if (kind === "route_sweep") return {
    url: $("rs-url").value.trim(),
    routes: $("rs-routes").value,
    viewports: Array.from(document.querySelectorAll("#rs-vps input[value]:checked")).map((c) => c.value),
    update_baselines: $("rs-update").checked,
    insecure: $("rs-insecure").checked,
    auto: $("rs-auto").checked,
  };
  if (kind === "api_contract") {
    // combine host + port (port defaults to Forge's 24631); default scheme http for a bare host
    let host = $("api-url").value.trim();
    const port = $("api-port").value.trim();
    if (host && !/^https?:\/\//.test(host)) host = "http://" + host;
    if (host && port) { try { const u = new URL(host); if (!u.port) { u.port = port; host = u.origin; } } catch (e) { /* leave as typed */ } }
    let spec = $("api-spec").value.trim();
    const inline = $("api-spec-json").value.trim();
    if (inline) { try { spec = JSON.parse(inline); } catch (e) { toast("api", false, "inline spec is not valid JSON"); throw e; } }
    else if (spec && spec.startsWith("/") && host) spec = host + spec;  // relative spec → absolute
    const tok = $("api-token").value.trim();
    return {
      url: host,
      mode: "spec",
      spec,
      auth: tok ? { token: tok } : null,
      include_writes: $("api-writes").checked,
      insecure: $("api-insecure").checked,
    };
  }
  if (kind === "api_contract_diff") {
    const parseSpecRef = (text) => {
      text = text.trim();
      if (!text) return null;
      try { return JSON.parse(text); } catch (e) { return text; }  // not JSON -> URL or git:<ref>:<path>
    };
    return {
      spec_a: parseSpecRef($("acd-spec-a").value),
      spec_b: parseSpecRef($("acd-spec-b").value),
      insecure: $("acd-insecure").checked,
      fail_on: $("acd-fail-on").value,
    };
  }
  if (kind === "contract_verify") return {
    url: $("cvf-url").value.trim(),
    har: $("cvf-har").value.trim(),
    insecure: $("cvf-insecure").checked,
    engagement_id: $("cvf-eng").value,
  };
  if (kind === "vitals") return {
    url: $("cwv-url").value.trim(),
    device: $("cwv-device").value,
    throttle: $("cwv-throttle").value,
    insecure: $("cwv-insecure").checked,
  };
  if (kind === "realtime") return {
    url: $("rt-url").value.trim(),
    ws: $("rt-ws").value.trim(),
    sse: $("rt-sse").value.trim(),
    ticket_url: $("rt-ticket").value.trim(),
    token: $("rt-token").value.trim(),
    subprotocol_jwt: $("rt-subproto").checked,
    expect_messages: parseInt($("rt-expect").value, 10) || 1,
    live_selector: $("rt-live").value.trim(),
    insecure: $("rt-insecure").checked,
  };
  if (kind === "auth_test") return {
    url: $("au-url").value.trim(),
    protected: $("au-protected").value.trim() || "/",
    login_url: $("au-login").value.trim(),
    api_login: $("au-api").value.trim(),
    logout_url: $("au-logout").value.trim(),
    username: $("au-user").value.trim(),
    password: $("au-pass").value,
    save_session: $("au-save").checked,
    insecure: $("au-insecure").checked,
  };
  if (kind === "har_replay") return {
    url: $("har-url").value.trim(),
    mode: $("har-mode").value,
    har: $("har-path").value.trim(),
    routes: $("har-routes").value,
    expect_text: $("har-expect").value.trim(),
    not_found_ok: $("har-fallback").checked,
    insecure: $("har-insecure").checked,
  };
  if (kind === "import_codegen") return {
    script: $("cg-script").value,
    url: $("cg-url").value.trim(),
    run: $("cg-run").checked,
    insecure: $("cg-insecure").checked,
  };
  if (kind === "misconfig_scan") return {
    url: $("ms-url").value.trim(),
    max_paths: parseInt($("ms-paths").value, 10) || 60,
    insecure: $("ms-insecure").checked,
    engagement_id: $("ms-eng").value,
  };
  if (kind === "cve_lookup") return {
    url: $("cve-url").value.trim(),
    insecure: $("cve-insecure").checked,
    engagement_id: $("cve-eng").value,
  };
  if (kind === "sca_scan") return {
    url: $("sca-url").value.trim(),
    checkout_path: $("sca-checkout").value.trim(),
    insecure: $("sca-insecure").checked,
    engagement_id: $("sca-eng").value,
  };
  if (kind === "llm_redteam") return {
    target: $("lr-target").value,
    base_url: $("lr-baseurl").value.trim(),
    api_key: $("lr-apikey").value,
    categories: Array.from(document.querySelectorAll("#lr-categories input:checked")).map((c) => c.value),
    engagement_id: $("lr-eng").value,
  };
  if (kind === "exploit_poc") return {
    url: $("ep-url").value.trim(),
    finding_description: $("ep-finding").value.trim(),
    timeout_s: parseInt($("ep-timeout").value, 10) || 60,
    engagement_id: $("ep-eng").value,
  };
  if (kind === "attack_chain") return {
    url: $("ac-url").value.trim(),
    objective: $("ac-objective").value.trim(),
    max_steps: parseInt($("ac-steps").value, 10) || 5,
    timeout_s: parseInt($("ac-timeout").value, 10) || 60,
    engagement_id: $("ac-eng").value,
  };
  if (kind === "host_pentest") {
    const envVar = $("hp-secretenv").value.trim();
    const creds = { username: $("hp-user").value.trim() };
    creds[$("hp-authmethod").value] = { "$secret": "env:" + envVar };
    return {
      host: $("hp-host").value.trim(),
      port: parseInt($("hp-port").value, 10) || 22,
      finding_description: $("hp-finding").value.trim(),
      creds,
      timeout_s: parseInt($("hp-timeout").value, 10) || 60,
      engagement_id: $("hp-eng").value,
    };
  }
  if (kind === "db_assert") {
    let queryParams = [];
    const qpText = $("dba-query-params").value.trim();
    if (qpText) {
      try { queryParams = JSON.parse(qpText); }
      catch (e) { toast("db_assert", false, "query params must be a JSON array"); throw e; }
    }
    const valText = $("dba-value").value.trim();
    let value = null;
    try { value = valText ? JSON.parse(valText) : null; } catch (e) { value = valText; }  // bare unquoted strings allowed too
    const mode = $("dba-mode").value;
    const assertion = { mode, op: $("dba-op").value, value };
    if (mode !== "row_count") assertion.column = $("dba-column").value.trim();
    if (mode === "cell_equals") assertion.row = parseInt($("dba-row").value, 10) || 0;
    return {
      engine: $("dba-engine").value,
      target: $("dba-target").value.trim(),
      db_secret: { "$secret": "env:" + $("dba-secretenv").value.trim() },
      query: $("dba-query").value.trim(),
      query_params: queryParams,
      assertion,
      timeout_s: parseInt($("dba-timeout").value, 10) || 30,
      engagement_id: $("dba-eng").value,
    };
  }
  if (kind === "chaos_inject") {
    if (!$("ci-consent").checked) {
      toast("chaos_inject", false, "confirm the target has consented to fault injection first");
      throw new Error("consent required");
    }
    const controlKind = $("ci-control-kind").value;
    return {
      url: $("ci-url").value.trim(),
      fault_type: $("ci-fault-type").value,
      latency_ms: parseInt($("ci-latency").value, 10) || 200,
      packet_loss_pct: parseInt($("ci-loss").value, 10) || 10,
      duration_s: parseInt($("ci-duration").value, 10) || 30,
      control_kind: controlKind,
      control_params: buildChaosControlParams(controlKind, $("ci-control-desc").value.trim()),
      error_rate_threshold_pct: parseFloat($("ci-error-threshold").value) || 10,
      recovery_sla_s: parseFloat($("ci-recovery-sla").value) || 30,
      insecure: $("ci-insecure").checked,
      target_accepts_fault_injection: true,
      engagement_id: $("ci-eng").value,
    };
  }
  if (kind === "chaos_webhook") {
    if (!$("cw-consent").checked) {
      toast("chaos_webhook", false, "confirm the target has consented to fault injection first");
      throw new Error("consent required");
    }
    const controlKind = $("cw-control-kind").value;
    return {
      url: $("cw-url").value.trim(),
      experiment_webhook_url: $("cw-start-url").value.trim(),
      experiment_stop_webhook_url: $("cw-stop-url").value.trim(),
      settle_s: parseInt($("cw-settle").value, 10) || 5,
      control_kind: controlKind,
      control_params: buildChaosControlParams(controlKind, $("cw-control-desc").value.trim()),
      error_rate_threshold_pct: parseFloat($("cw-error-threshold").value) || 10,
      recovery_sla_s: parseFloat($("cw-recovery-sla").value) || 30,
      insecure: $("cw-insecure").checked,
      target_accepts_fault_injection: true,
      engagement_id: $("cw-eng").value,
    };
  }
  if (kind === "cloud_pentest") {
    let creds = {};
    const raw = $("cp-creds").value.trim();
    if (raw) {
      try { creds = JSON.parse(raw); }
      catch (e) { toast("cloud_pentest", false, "creds is not valid JSON"); throw e; }
    }
    return {
      provider: $("cp-provider").value,
      target: $("cp-target").value.trim(),
      finding_description: $("cp-finding").value.trim(),
      creds,
      timeout_s: parseInt($("cp-timeout").value, 10) || 60,
      engagement_id: $("cp-eng").value,
    };
  }
  if (kind === "port_scan") return {
    url: $("ps-url").value.trim(),
    ports: $("ps-ports").value.trim() || undefined,
    engagement_id: $("ps-eng").value,
  };
  if (kind === "tls_cipher_scan") {
    const p = { url: $("tcs-url").value.trim(), engagement_id: $("tcs-eng").value };
    const port = parseInt($("tcs-port").value, 10);
    if (port) p.port = port;
    return p;
  }
  if (kind === "dast_scan") return {
    url: $("dast-url").value.trim(),
    insecure: $("dast-insecure").checked,
    engagement_id: $("dast-eng").value,
  };
  if (kind === "injection_scan") return {
    url: $("inj-url").value.trim(),
    insecure: $("inj-insecure").checked,
    engagement_id: $("inj-eng").value,
  };
  if (kind === "csrf_probe") return {
    url: $("csrf-url").value.trim(),
    insecure: $("csrf-insecure").checked,
    engagement_id: $("csrf-eng").value,
  };
  if (kind === "ssrf_probe") {
    const p = {
      url: $("ssrf-url").value.trim(),
      insecure: $("ssrf-insecure").checked,
      engagement_id: $("ssrf-eng").value,
    };
    const param = $("ssrf-param").value.trim();
    if (param) p.param = param;
    return p;
  }
  if (kind === "auth_attack_scan") {
    const p = {
      url: $("aas-url").value.trim(),
      insecure: $("aas-insecure").checked,
      engagement_id: $("aas-eng").value,
    };
    const login = $("aas-login").value.trim();
    if (login) p.login_url = login;
    return p;
  }
  if (kind === "idor_scan") {
    const p = {
      url: $("idor-url").value.trim(),
      insecure: $("idor-insecure").checked,
      engagement_id: $("idor-eng").value,
    };
    const cookie = $("idor-cookie").value.trim();
    if (cookie) p.cookie = cookie;
    return p;
  }
  const PROBES = ["redirects","headers","cookies","robots","security_paths","api_check","sitemap_test","dns_records","cors","transport"];
  if (PROBES.includes(kind)) {
    const t = $("pr-target").value.trim();
    return kind === "dns_records" ? { host: t } : { url: t };
  }
  return {};
}

async function startJob(kind) {
  const el = $("run-status");
  el.classList.remove("err");
  if (kind === "regression" && $("reg-update").checked
      && !confirm("Update baselines? Current screenshots become the new reference.")) return;
  try {
    const res = await fetch("/api/dashboard/jobs", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ kind, params: jobParams(kind) }),
    });
    if (res.status === 409) { el.textContent = "a job is already in progress"; return; }
    if (res.status === 400 || res.status === 422) {
      const data = await res.json();
      el.classList.add("err");
      el.textContent = String(data.detail || "invalid request").slice(0, 90);
      return;
    }
    $("job-result").style.display = "none";
    await sync();
    showPanel("overview", { scrollTarget: "job-live" });
  } catch (err) {
    el.classList.add("err");
    el.textContent = "trigger failed: " + err;
  }
}
$("btn-stop").addEventListener("click", async () => {
  if (!confirm("Stop the running job?")) return;
  await fetch("/api/dashboard/jobs/cancel", { method: "POST" });
  toast("job", false, "cancellation requested");
  sync();
});
$("btn-copylog").addEventListener("click", () => {
  navigator.clipboard.writeText(window._lastLog || "").then(() => toast("copied", true, "log copied to clipboard"));
});
$("btn-dllog").addEventListener("click", () => {
  const blob = new Blob([window._lastLog || ""], { type: "text/plain" });
  const a = document.createElement("a");
  a.href = URL.createObjectURL(blob);
  a.download = "argus-job.log";
  a.click();
  URL.revokeObjectURL(a.href);
});
for (const btn of document.querySelectorAll(".act-btn")) {
  btn.addEventListener("click", () => startJob(btn.dataset.kind));
}

