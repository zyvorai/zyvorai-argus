<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Sign in · Zyvor Argus Mission Control</title>
<script>
(function () {
  var t = localStorage.getItem("zyvor-theme");
  document.documentElement.setAttribute("data-theme", t === "light" ? "light" : "dark");
})();
</script>
<style>
{% include 'dashboard/css/_tokens.css.j2' %}
  * { box-sizing: border-box; }
  html, body { margin: 0; min-height: 100%; }
  body {
    font-family: var(--font-base); color: var(--text); background: var(--wallpaper), var(--bg); background-attachment: fixed;
    -webkit-font-smoothing: antialiased; line-height: 1.47059; letter-spacing: -0.022em;
  }
  :focus-visible { outline: 3px solid var(--focus-ring); outline-offset: 2px; border-radius: var(--r-small); }
  .login-shell { display: flex; min-height: 100vh; padding: var(--rail-inset); gap: var(--rail-inset); }
  .login-rail {
    width: 300px; flex: none; background: var(--rail-bg); border-radius: var(--r-panel);
    -webkit-backdrop-filter: var(--glass-blur); backdrop-filter: var(--glass-blur);
    box-shadow: var(--shadow-sm), var(--glass-highlight); padding: 40px 32px;
    display: flex; flex-direction: column; justify-content: space-between;
  }
  .argus-lockup { display: flex; align-items: center; gap: 12px; margin-bottom: 6px; }
  .argus-icon { border-radius: 22%; flex: none; box-shadow: 0 0 0 1px var(--border), 0 6px 20px rgba(124,108,255,0.28); }
  .argus-name { font-size: 1.6rem; font-weight: 650; letter-spacing: -0.03em; color: var(--text); }
  .zyvor-mark { display: inline-flex; align-items: center; gap: 7px; color: var(--text-secondary); text-decoration: none; margin-bottom: 16px; }
  .zyvor-mark .mark-word { font-weight: 600; font-size: 12px; letter-spacing: 0; }
  .rail-title { font-size: clamp(1.75rem, 3vw, 2.25rem); font-weight: 650; letter-spacing: -0.03em; margin: 0 0 12px; line-height: 1.1; }
  .rail-tagline { margin: 0; color: var(--text-secondary); font-size: 1.02rem; max-width: 20rem; }
  .rail-features { display: flex; flex-direction: column; gap: 4px; margin-top: 36px; }
  .rail-feature { padding: 14px 0; border-top: 1px solid var(--border); font-size: 0.92rem; color: var(--text-secondary); }
  .rail-feature strong { display: block; color: var(--text); font-weight: 650; margin-bottom: 4px; font-size: 0.95rem; }
  .login-main { flex: 1; display: flex; align-items: center; justify-content: center; padding: 32px 16px; }
  .login-card {
    width: 100%; max-width: 410px; background: var(--surface); border-radius: var(--r-panel);
    -webkit-backdrop-filter: var(--glass-blur); backdrop-filter: var(--glass-blur);
    box-shadow: var(--shadow-md), var(--glass-highlight); padding: 36px 32px;
  }
  .mobile-brand { display: none; text-align: center; margin-bottom: 28px; }
  .mobile-brand .rail-title { font-size: 1.5rem; }
  .card-title { font-size: 1.5rem; font-weight: 650; letter-spacing: -0.02em; margin: 0 0 4px; }
  .card-sub { font-size: 0.95rem; color: var(--text-secondary); margin: 0 0 28px; }
  .field-label { display: block; font-size: 0.85rem; font-weight: 600; color: var(--text); margin: 0 0 8px; }
  .field { margin-bottom: 18px; }
  .login-input {
    width: 100%; min-height: 44px; padding: 0 14px; border-radius: var(--r-control); font-size: 0.95rem;
    color: var(--text); background: var(--fill); border: 1px solid transparent;
    font-family: inherit; transition: background 0.15s, border-color 0.15s, box-shadow 0.15s;
  }
  .login-input::placeholder { color: var(--text-muted); }
  .login-input:hover { background: var(--fill-strong); }
  .login-input:focus { outline: none; background: var(--surface-solid); border-color: var(--accent); box-shadow: 0 0 0 3px var(--focus-ring); }
  .remember { display: flex; align-items: center; gap: 10px; margin: 4px 0 0; cursor: pointer; user-select: none; }
  .remember input { width: 16px; height: 16px; accent-color: var(--accent); }
  .remember span { font-size: 0.875rem; color: var(--text-secondary); }
  .login-btn-primary {
    display: flex; align-items: center; justify-content: center; width: 100%; min-height: 44px;
    margin-top: 24px; padding: 0 16px; font-size: 0.95rem; font-weight: 600;
    color: #fff; border-radius: 980px; cursor: pointer; border: none;
    background: var(--accent-fill); font-family: inherit; box-shadow: 0 1px 2px rgba(0,0,0,0.25), inset 0 1px 0 rgba(255,255,255,0.18);
    transition: background 0.15s;
  }
  .login-btn-primary:hover:not(:disabled) { background: #1a7bff; }
  .login-btn-primary:disabled { opacity: 0.5; cursor: not-allowed; }
  .login-error {
    display: none; align-items: flex-start; gap: 10px; background: var(--error-soft);
    border-radius: var(--r-control); padding: 12px; margin-bottom: 20px; font-size: 0.875rem; color: var(--status-error);
  }
  .login-error.show { display: flex; }
  .panel-hint { font-size: 0.78rem; text-align: center; margin-top: 20px; color: var(--text-muted); line-height: 1.6; }
  .panel-hint code { font-family: var(--font-mono); font-size: 0.85em; background: var(--code-bg); padding: 1px 5px; border-radius: 6px; }
  @media (max-width: 900px) {
    .login-rail { display: none; }
    .mobile-brand { display: block; }
  }
  @media (prefers-reduced-motion: reduce) { * { transition-duration: 0.01ms !important; } }
</style>
{% from "dashboard/_brand.html.j2" import argus_icon, zyvor_credit, favicon_href %}
<link rel="icon" type="image/svg+xml" href="{{ favicon_href() | trim }}">
</head>
<body>
<div class="login-shell">
  <aside class="login-rail" aria-label="Zyvor Argus">
    <div>
      <div class="argus-lockup">{{ argus_icon("lr", 44) }}<span class="argus-name">Argus</span></div>
      {{ zyvor_credit() }}
      <h1 class="rail-title">Mission Control</h1>
      <p class="rail-tagline">Autonomous testing, security, and requirements quality for your product.</p>
      <div class="rail-features">
        <div class="rail-feature">
          <strong>Autonomous pipeline</strong>
          Spec to tests to execution to report — triggered by GitHub or one click.
        </div>
        <div class="rail-feature">
          <strong>Self-healing autofix</strong>
          Broken selectors diagnosed, repaired, and re-run automatically.
        </div>
        <div class="rail-feature">
          <strong>Coverage discovery</strong>
          Finds untested routes from your repo and live site crawl.
        </div>
      </div>
    </div>
    <p class="rail-tagline" style="font-size:0.85rem;margin:0">AGPL-3.0 · ZyvorAI Labs</p>
  </aside>

  <main class="login-main">
    <div class="login-card">
      <div class="mobile-brand">
        <div class="argus-lockup" style="justify-content:center">{{ argus_icon("lm", 40) }}<span class="argus-name">Argus</span></div>
        {{ zyvor_credit() }}
        <h1 class="rail-title" style="font-size:1.5rem;margin-top:8px">Mission Control</h1>
      </div>

      <h2 class="card-title">Sign in</h2>
      <p class="card-sub">Enter your credentials to open the console.</p>

      <div class="login-error" id="err" role="alert">
        <span id="err-msg">Invalid username or password</span>
      </div>

      <form id="form" autocomplete="on">
        <label class="field-label" for="username">Username</label>
        <div class="field">
          <input class="login-input" id="username" name="username" placeholder="Username" required autofocus>
        </div>
        <label class="field-label" for="password">Password</label>
        <div class="field" style="margin-bottom:0">
          <input class="login-input" id="password" name="password" type="password" placeholder="Password" required>
        </div>
        <label class="remember">
          <input type="checkbox" id="remember">
          <span>Remember me on this device</span>
        </label>
        <button class="login-btn-primary" id="submit" type="submit">Sign in</button>
      </form>

      <p class="panel-hint">
        {% if auth_enabled %}Credentials are set via <code>DASHBOARD_USER</code> / <code>DASHBOARD_PASSWORD</code> on the server.{% else %}Authentication is not configured — set <code>DASHBOARD_PASSWORD</code> to protect this dashboard.{% endif %}
      </p>
    </div>
  </main>
</div>

<script>
"use strict";
const form = document.getElementById("form");
form.addEventListener("submit", async (ev) => {
  ev.preventDefault();
  const btn = document.getElementById("submit");
  const err = document.getElementById("err");
  err.classList.remove("show");
  btn.disabled = true;
  btn.textContent = "Signing in…";
  try {
    const csrf = document.cookie.split("; ").find((c) => c.startsWith("zyvor_qa_csrf="));
    const headers = { "Content-Type": "application/json" };
    if (csrf) headers["X-CSRF-Token"] = decodeURIComponent(csrf.split("=").slice(1).join("="));
    const res = await fetch("/api/login", {
      method: "POST",
      headers,
      body: JSON.stringify({
        username: document.getElementById("username").value,
        password: document.getElementById("password").value,
        remember: document.getElementById("remember").checked,
      }),
    });
    const data = await res.json();
    if (res.ok && data.ok) {
      const next = new URLSearchParams(location.search).get("next") || "/dashboard";
      location.href = next.startsWith("/") ? next : "/dashboard";
      return;
    }
    document.getElementById("err-msg").textContent = data.detail || "Invalid username or password";
    err.classList.add("show");
  } catch (e) {
    document.getElementById("err-msg").textContent = "Connection failed — " + e;
    err.classList.add("show");
  }
  btn.disabled = false;
  btn.textContent = "Sign in";
});
</script>
</body>
</html>
