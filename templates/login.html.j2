<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Sign in · Zyvor Argus Mission Control</title>
<script>
(function () {
  var t = localStorage.getItem("zyvor-theme");
  document.documentElement.setAttribute("data-theme", t === "light" ? "light" : "dark");
})();
</script>
<style>
  :root {
    color-scheme: dark;
    --bg: #1d1d1f;
    --surface: #2c2c2e;
    --rail-bg: #161617;
    --text: #f5f5f7;
    --text-secondary: #a1a1a6;
    --text-muted: #86868b;
    --border: #424245;
    --accent: #2997ff;
    --accent-hover: #0077ed;
    --radius: 12px;
    --rail-width: 280px;
    --status-error: #ff453a;
    --font-base: -apple-system, BlinkMacSystemFont, "SF Pro Text", "Segoe UI", system-ui, sans-serif;
    --code-bg: #3a3a3c;
    --focus-ring: rgba(41,151,255,0.28);
    --shadow-sm: 0 2px 16px rgba(0,0,0,0.35);
  }
  [data-theme="light"] {
    color-scheme: light;
    --bg: #fbfbfd;
    --surface: #ffffff;
    --rail-bg: #f5f5f7;
    --text: #1d1d1f;
    --text-secondary: #6e6e73;
    --text-muted: #86868b;
    --border: #d2d2d7;
    --accent: #0071e3;
    --accent-hover: #0077ed;
    --status-error: #ff3b30;
    --code-bg: #eee;
    --focus-ring: rgba(0,113,227,0.15);
    --shadow-sm: 0 2px 16px rgba(0,0,0,0.06);
  }
  * { box-sizing: border-box; }
  html, body { margin: 0; min-height: 100%; }
  body {
    font-family: var(--font-base); color: var(--text); background: var(--bg);
    -webkit-font-smoothing: antialiased; line-height: 1.47059; letter-spacing: -0.022em;
  }
  .login-shell { display: flex; min-height: 100vh; }
  .login-rail {
    width: var(--rail-width); flex: none; background: var(--rail-bg);
    border-right: 1px solid var(--border); padding: 48px 40px;
    display: flex; flex-direction: column; justify-content: space-between;
  }
  .argus-lockup { display: flex; align-items: center; gap: 12px; margin-bottom: 6px; }
  .argus-icon { border-radius: 22%; flex: none; box-shadow: 0 0 0 1px var(--border), 0 6px 20px rgba(124,108,255,0.28); }
  .argus-name { font-size: 1.6rem; font-weight: 650; letter-spacing: -0.03em; color: var(--text); }
  .zyvor-mark {
    display: inline-flex; align-items: center; gap: 7px;
    color: var(--text-secondary); text-decoration: none; margin-bottom: 16px;
  }
  .zyvor-mark .mark-word {
    font-weight: 600; font-size: 12px; letter-spacing: 0;
  }
  .rail-title {
    font-size: clamp(1.75rem, 3vw, 2.25rem); font-weight: 600;
    letter-spacing: -0.03em; margin: 0 0 12px; line-height: 1.1;
  }
  .rail-tagline { margin: 0; color: var(--text-secondary); font-size: 1.05rem; max-width: 20rem; }
  .rail-features { display: flex; flex-direction: column; gap: 14px; margin-top: 40px; }
  .rail-feature {
    padding: 14px 0; border-top: 1px solid var(--border);
    font-size: 0.92rem; color: var(--text-secondary);
  }
  .rail-feature strong { display: block; color: var(--text); font-weight: 600; margin-bottom: 4px; font-size: 0.95rem; }
  .login-main {
    flex: 1; display: flex; align-items: center; justify-content: center;
    padding: 48px 24px;
  }
  .login-card {
    width: 100%; max-width: 400px; background: var(--surface);
    border: 1px solid var(--border); border-radius: var(--radius);
    box-shadow: var(--shadow-sm); padding: 36px 32px;
  }
  .mobile-brand { display: none; text-align: center; margin-bottom: 28px; }
  .mobile-brand .rail-title { font-size: 1.5rem; }
  .card-title { font-size: 1.5rem; font-weight: 600; letter-spacing: -0.02em; margin: 0 0 4px; }
  .card-sub { font-size: 0.95rem; color: var(--text-secondary); margin: 0 0 28px; }
  .field-label { display: block; font-size: 0.875rem; font-weight: 500; color: var(--text); margin: 0 0 8px; }
  .field { margin-bottom: 18px; }
  .login-input {
    width: 100%; padding: 11px 14px; border-radius: 8px; font-size: 0.95rem;
    color: var(--text); background: var(--surface); border: 1px solid var(--border);
    font-family: inherit; transition: border-color 0.15s, box-shadow 0.15s;
  }
  .login-input:focus {
    outline: none; border-color: var(--accent);
    box-shadow: 0 0 0 3px var(--focus-ring);
  }
  .remember { display: flex; align-items: center; gap: 10px; margin: 4px 0 0; cursor: pointer; user-select: none; }
  .remember input { width: 16px; height: 16px; accent-color: var(--accent); }
  .remember span { font-size: 0.875rem; color: var(--text-secondary); }
  .login-btn-primary {
    display: flex; align-items: center; justify-content: center; width: 100%;
    margin-top: 24px; padding: 12px 16px; font-size: 0.95rem; font-weight: 500;
    color: #fff; border-radius: 980px; cursor: pointer; border: none;
    background: var(--accent); font-family: inherit;
    transition: background 0.15s;
  }
  .login-btn-primary:hover:not(:disabled) { background: var(--accent-hover); }
  .login-btn-primary:disabled { opacity: 0.5; cursor: not-allowed; }
  .login-error {
    display: none; align-items: flex-start; gap: 10px;
    background: rgba(255,59,48,0.08); border: 1px solid rgba(255,59,48,0.35);
    border-radius: 8px; padding: 12px; margin-bottom: 20px;
    font-size: 0.875rem; color: var(--status-error);
  }
  .login-error.show { display: flex; }
  .panel-hint {
    font-size: 0.78rem; text-align: center; margin-top: 20px;
    color: var(--text-muted); line-height: 1.6;
  }
  .panel-hint code {
    font-family: ui-monospace, Menlo, monospace; font-size: 0.85em;
    background: var(--code-bg); padding: 1px 5px; border-radius: 4px;
  }
  @media (max-width: 900px) {
    .login-rail { display: none; }
    .mobile-brand { display: block; }
  }
  @media (prefers-reduced-motion: reduce) {
    * { transition-duration: 0.01ms !important; }
  }
</style>
{% from "dashboard/_brand.html.j2" import argus_icon, zyvor_credit, favicon_href %}
<link rel="icon" type="image/svg+xml" href="{{ favicon_href() | trim }}">
</head>
<body>
<div class="login-shell">
  <aside class="login-rail" aria-label="Zyvor Argus">
    <div>
      <div class="argus-lockup">{{ argus_icon("lr", 44) }}<span class="argus-name">Argus</span></div>
      {{ zyvor_credit() }}
      <h1 class="rail-title">Mission Control</h1>
      <p class="rail-tagline">Autonomous testing, security, and requirements quality for your product.</p>
      <div class="rail-features">
        <div class="rail-feature">
          <strong>Autonomous pipeline</strong>
          Spec to tests to execution to report — triggered by GitHub or one click.
        </div>
        <div class="rail-feature">
          <strong>Self-healing autofix</strong>
          Broken selectors diagnosed, repaired, and re-run automatically.
        </div>
        <div class="rail-feature">
          <strong>Coverage discovery</strong>
          Finds untested routes from your repo and live site crawl.
        </div>
      </div>
    </div>
    <p class="rail-tagline" style="font-size:0.85rem;margin:0">AGPL-3.0 · ZyvorAI Labs</p>
  </aside>

  <main class="login-main">
    <div class="login-card">
      <div class="mobile-brand">
        <div class="argus-lockup" style="justify-content:center">{{ argus_icon("lm", 40) }}<span class="argus-name">Argus</span></div>
        {{ zyvor_credit() }}
        <h1 class="rail-title" style="font-size:1.5rem;margin-top:8px">Mission Control</h1>
      </div>

      <h2 class="card-title">Sign in</h2>
      <p class="card-sub">Enter your credentials to open the console.</p>

      <div class="login-error" id="err" role="alert">
        <span id="err-msg">Invalid username or password</span>
      </div>

      <form id="form" autocomplete="on">
        <label class="field-label" for="username">Username</label>
        <div class="field">
          <input class="login-input" id="username" name="username" placeholder="Username" required autofocus>
        </div>
        <label class="field-label" for="password">Password</label>
        <div class="field" style="margin-bottom:0">
          <input class="login-input" id="password" name="password" type="password" placeholder="Password" required>
        </div>
        <label class="remember">
          <input type="checkbox" id="remember">
          <span>Remember me on this device</span>
        </label>
        <button class="login-btn-primary" id="submit" type="submit">Sign in</button>
      </form>

      <p class="panel-hint">
        {% if auth_enabled %}Credentials are set via <code>DASHBOARD_USER</code> / <code>DASHBOARD_PASSWORD</code> on the server.{% else %}Authentication is not configured — set <code>DASHBOARD_PASSWORD</code> to protect this dashboard.{% endif %}
      </p>
    </div>
  </main>
</div>

<script>
"use strict";
const form = document.getElementById("form");
form.addEventListener("submit", async (ev) => {
  ev.preventDefault();
  const btn = document.getElementById("submit");
  const err = document.getElementById("err");
  err.classList.remove("show");
  btn.disabled = true;
  btn.textContent = "Signing in…";
  try {
    const csrf = document.cookie.split("; ").find((c) => c.startsWith("zyvor_qa_csrf="));
    const headers = { "Content-Type": "application/json" };
    if (csrf) headers["X-CSRF-Token"] = decodeURIComponent(csrf.split("=").slice(1).join("="));
    const res = await fetch("/api/login", {
      method: "POST",
      headers,
      body: JSON.stringify({
        username: document.getElementById("username").value,
        password: document.getElementById("password").value,
        remember: document.getElementById("remember").checked,
      }),
    });
    const data = await res.json();
    if (res.ok && data.ok) {
      const next = new URLSearchParams(location.search).get("next") || "/dashboard";
      location.href = next.startsWith("/") ? next : "/dashboard";
      return;
    }
    document.getElementById("err-msg").textContent = data.detail || "Invalid username or password";
    err.classList.add("show");
  } catch (e) {
    document.getElementById("err-msg").textContent = "Connection failed — " + e;
    err.classList.add("show");
  }
  btn.disabled = false;
  btn.textContent = "Sign in";
});
</script>
</body>
</html>
