<section id="panel-quality" class="panel">
  <div class="panel-head">
    <h1>Quality</h1>
    <p>Site audits, flaky detection, Core Web Vitals, and crawl validation.</p>
  </div>
  <div class="acts">
<div class="glass card act span-all" id="action-audit">
      <div class="act-title">🔬 Site audit — accessibility, links, SEO, performance, security per page</div>
      <div class="act-row">
        <input aria-label="URL" class="inp grow" id="au-url" placeholder="https://your-app.example.com">
        <input class="inp w-80" id="au-pages" type="number" value="10" min="1" max="100" title="max pages">
        <label class="chk"><input type="checkbox" id="au-insecure"> self-signed TLS</label>
      </div>
      <div class="act-row gap-12" id="au-checks">
        <label class="chk"><input type="checkbox" value="a11y" checked> a11y</label>
        <label class="chk"><input type="checkbox" value="links" checked> links</label>
        <label class="chk"><input type="checkbox" value="seo" checked> SEO</label>
        <label class="chk"><input type="checkbox" value="console" checked> console</label>
        <label class="chk"><input type="checkbox" value="perf" checked> perf</label>
        <label class="chk"><input type="checkbox" value="headers" checked> headers</label>
        <label class="chk"><input type="checkbox" value="responsive"> responsive</label>
        <button class="run-btn act-btn ml-auto" data-kind="audit">🔬 Run audit</button>
      </div>
    </div>
    
<div class="glass card act" id="action-flaky">
      <div class="act-title">🎲 Flaky check — run repeatedly, find unstable tests</div>
      <div class="act-row">
        <label class="d" for="fl-runs">runs</label><input class="inp w-70" id="fl-runs" type="number" value="3" min="2" max="10">
        <button class="run-btn act-btn ml-auto" data-kind="flaky">🎲 Detect flaky</button>
      </div>
    </div>
    
<div class="glass card act" id="action-vitals">
      <div class="act-title">📊 Web Vitals — LCP / CLS / INP graded</div>
      <div class="act-row"><input aria-label="URL" class="inp grow" id="cwv-url" placeholder="https://…"></div>
      <div class="act-row gap-10">
        <label class="select-field"><span>Device</span><select class="inp" id="cwv-device"><option value="">desktop</option><option>iPhone 14</option><option>iPhone 15 Pro</option><option>Pixel 7</option><option>iPad Pro 11</option></select></label>
        <label class="select-field"><span>Network</span><select class="inp" id="cwv-throttle"><option value="">no throttle</option><option value="3g">3G</option><option value="offline">offline</option></select></label>
        <label class="chk"><input type="checkbox" id="cwv-insecure"> self-signed TLS</label>
        <button class="run-btn act-btn ml-auto" data-kind="vitals">📊 Measure</button>
      </div>
    </div>
    
<div class="glass card act span-all" id="action-crawl">
      <div class="act-title">🌐 Test any site — crawl every page and validate it</div>
      <div class="act-row">
        <input aria-label="URL" class="inp grow" id="ct-url" placeholder="https://your-app.example.com (any UX — self-signed TLS OK)">
        <input class="inp w-90" id="ct-pages" type="number" value="30" min="1" max="200" title="max pages">
      </div>
      <div class="act-row">
        <input aria-label="Username" class="inp grow" id="ct-user" placeholder="login username (optional)" autocomplete="off">
        <input aria-label="Password" class="inp grow" id="ct-pass" type="password" placeholder="login password (optional)" autocomplete="off">
        <label class="chk"><input type="checkbox" id="ct-insecure"> allow self-signed TLS</label>
        <button class="run-btn act-btn" data-kind="crawl_test">🌐 Crawl &amp; test all pages</button>
      </div>
    </div>
    
  </div>
</section>
