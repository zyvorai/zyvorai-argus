async function openRequirementDetail(id) {
  const card = $("req-detail-card"), body = $("req-detail-body");
  card.style.display = "block";
  $("req-detail-title").textContent = id;
  body.innerHTML = '<span class="d">loading…</span>';
  card.scrollIntoView({ behavior: "smooth", block: "start" });
  try {
    const [detail, hist] = await Promise.all([
      fetch("/api/v2/requirements/" + encodeURIComponent(id)).then((r) => r.json()),
      fetch("/api/v2/requirements/" + encodeURIComponent(id) + "/history").then((r) => r.json()),
    ]);
    $("req-detail-title").textContent = detail.title || id;
    const issues = (detail.quality_issues || []);
    const issuesHtml = issues.length
      ? '<ul style="margin:4px 0 0 18px;padding:0">' + issues.map((i) =>
          "<li>" + esc(i.reason || i.kind || JSON.stringify(i)) + "</li>").join("") + "</ul>"
      : '<span class="d">none</span>';
    const versions = (hist.versions || []).slice().reverse();
    const versionsHtml = versions.map((v) => {
      const tests = v.linked_tests || [];
      return '<div class="py-8 bt">'
        + '<div><b>v' + esc(v.version) + '</b> <span class="d">' + relIso(v.created_at) + '</span>'
        + ' <span class="chip" style="color:' + scoreColor(v.quality_score) + '">score ' + (v.quality_score != null ? Math.round(v.quality_score) : "—") + "</span></div>"
        + (tests.length
            ? '<div class="d" style="margin-top:4px">generated tests: ' + tests.map((t) => "<code>" + esc(t) + "</code>").join(", ") + "</div>"
            : "")
        + "</div>";
    }).join("");
    body.innerHTML = '<div class="d">' + esc(detail.source_type || "") + (detail.origin_id ? " · " + esc(detail.origin_id) : "") + "</div>"
      + '<div class="mt-10"><b>Description</b><div class="d pre-wrap mt-2">' + esc((detail.content && detail.content.description) || "") + "</div></div>"
      + '<div class="mt-10"><b>Quality issues</b>' + issuesHtml + "</div>"
      + '<div class="mt-10"><b>Version history</b>' + (versionsHtml || '<span class="d">none</span>') + "</div>";
  } catch (e) {
    body.innerHTML = '<span class="d">failed to load — ' + esc(String(e)) + "</span>";
  }
}
