  { label: "Show recorded videos", action: () => { showPanel("operations"); if (!videosOpen) $("videos-toggle").click(); } },
];
let palSel = 0, palFiltered = PALETTE_CMDS, palOpener = null;
const PAL_RECENT_KEY = "zyvor-palette-recent";
function palRecents() {
  try { return JSON.parse(localStorage.getItem(PAL_RECENT_KEY) || "[]"); } catch (e) { return []; }
}
function palRemember(label) {
  try {
    var r = palRecents().filter(function (l) { return l !== label; });
    r.unshift(label);
    localStorage.setItem(PAL_RECENT_KEY, JSON.stringify(r.slice(0, 5)));
  } catch (e) {}
}
function openPalette() {
  palOpener = document.activeElement;
  $("palette").style.display = "flex";
  $("palette-input").value = ""; palSel = 0; renderPalette();
  $("palette-input").focus();
}
function closePalette() {
  $("palette").style.display = "none";
  if (palOpener && palOpener.focus && document.contains(palOpener)) palOpener.focus();
  palOpener = null;
}
function renderPalette() {
  const q = $("palette-input").value.toLowerCase();
  palFiltered = PALETTE_CMDS.filter((c) => c.label.toLowerCase().includes(q));
  const recent = q ? [] : palRecents();
  if (recent.length) {
    // Empty query: surface recently used commands first.
    const rank = (c) => { const i = recent.indexOf(c.label); return i === -1 ? recent.length : i; };
    palFiltered = palFiltered.map((c, i) => ({ c, i })).sort((a, b) => rank(a.c) - rank(b.c) || a.i - b.i).map((x) => x.c);
  }
  if (palSel >= palFiltered.length) palSel = 0;
  $("palette-list").innerHTML = palFiltered.map((c, i) =>
    '<div class="palette-item ' + (i === palSel ? "sel" : "") + '" data-i="' + i + '" role="option" id="pal-opt-' + i
    + '" aria-selected="' + (i === palSel ? "true" : "false") + '">'
    + esc(c.label)
    + (recent.indexOf(c.label) !== -1 ? '<span class="pk">recent</span>' : (c.kind ? '<span class="pk">action</span>' : '<span class="pk">view</span>'))
    + "</div>").join("");
  if (palFiltered.length) $("palette-input").setAttribute("aria-activedescendant", "pal-opt-" + palSel);
  else $("palette-input").removeAttribute("aria-activedescendant");
  for (const el of $("palette-list").querySelectorAll(".palette-item"))
    el.addEventListener("click", () => runPalette(parseInt(el.dataset.i, 10)));
}
function runPalette(i) {
  const cmd = palFiltered[i];
  closePalette();
  if (!cmd) return;
  palRemember(cmd.label);
  if (cmd.kind) startJob(cmd.kind);
  else if (cmd.action) cmd.action();
}
$("palette-input").addEventListener("input", renderPalette);
$("palette-input").addEventListener("keydown", (ev) => {
  if (ev.key === "ArrowDown") { palSel = Math.min(palSel + 1, palFiltered.length - 1); renderPalette(); ev.preventDefault(); }
  else if (ev.key === "ArrowUp") { palSel = Math.max(palSel - 1, 0); renderPalette(); ev.preventDefault(); }
  else if (ev.key === "Enter") runPalette(palSel);
  else if (ev.key === "Escape") closePalette();
  else if (ev.key === "Tab") ev.preventDefault(); // modal: keep focus in the palette
});
$("palette").addEventListener("click", (ev) => { if (ev.target.id === "palette") closePalette(); });

/* ── Ask Zyra (knowledge RAG) ── */
const ASK_LS_PRODUCT = "zyvor-ask-product";
const ASK_LS_DRAFT = "zyvor-ask-draft";
let askThreadId = null;
let askLastPayload = null;
let askBusy = false;
let askStreamingPreferred = true;
let remediationThreadId = null;

function focusAskZyvor() {
  showPanel("ask");
  const q = $("ask-question");
  if (q) q.focus();
}

function formatAskAnswer(text) {
  const escaped = esc(text || "");
  return escaped
    .replace(/```([\s\S]*?)```/g, "<code>$1</code>")
    .replace(/`([^`]+)`/g, "<code>$1</code>");
}

function renderAskBubble(role, html, metaHtml) {
  const cls = role === "user" ? "ask-bubble user" : "ask-bubble assistant";
  return '<div class="' + cls + '">'
    + (metaHtml || "")
    + '<div class="ask-answer">' + html + "</div></div>";
}

function citationMarkdown(citations) {
  if (!citations || !citations.length) return "";
  return "\n\n## Sources\n" + citations.map((c, i) => {
    const bits = [c.title || c.document_id, c.section, c.source].filter(Boolean).join(" · ");
    return (i + 1) + ". " + bits + (c.url ? " — " + c.url : "");
  }).join("\n");
}

function lastAnswerMarkdown() {
  if (!askLastPayload) return "";
  const p = askLastPayload;
  let md = "# Ask Zyra answer\n\n" + (p.answer || "") + "\n";
  md += "\nConfidence: " + (p.confidence || "unknown") + "\n";
  if (p.insufficient_context) md += "\nInsufficient context: true\n";
  if (p.missing_information && p.missing_information.length) {
    md += "\nMissing information:\n" + p.missing_information.map((m) => "- " + m).join("\n") + "\n";
  }
  if (p.recommended_action) md += "\nRecommended action: " + p.recommended_action + "\n";
  md += citationMarkdown(p.citations || []);
  return md;
}

function appendAskTurn(role, html, metaHtml, abstain) {
  const el = $("ask-thread");
  if (el.querySelector(".d") && !el.querySelector(".ask-bubble")) el.innerHTML = "";
  const wrap = document.createElement("div");
  wrap.innerHTML = renderAskBubble(role, html, metaHtml);
  const node = wrap.firstChild;
  if (abstain && node) node.classList.add("abstain");
  el.appendChild(node);
  el.scrollTop = el.scrollHeight;
}

function renderAssistantPayload(payload, latencyMs) {
  const conf = payload.confidence || "low";
  const retrieval = payload.retrieval || {};
  let meta = '<div class="ask-meta">'
    + '<span class="ask-badge ' + esc(conf) + '">' + esc(conf) + "</span>";
  if (payload.insufficient_context) meta += '<span class="ask-badge low">insufficient context</span>';
  if (latencyMs != null) meta += "<span>" + Math.round(latencyMs) + " ms</span>";
  if (retrieval.documents_considered != null) {
    meta += "<span>" + retrieval.validated_citations + "/" + retrieval.documents_considered + " citations validated</span>";
  }
  meta += "</div>";

  let body = formatAskAnswer(payload.answer || "");
  if (payload.missing_information && payload.missing_information.length) {
    body += "\n\nMissing information:\n" + payload.missing_information.map((m) => "• " + esc(m)).join("\n");
  }
  if (payload.recommended_action) {
    body += "\n\nRecommended action: " + esc(payload.recommended_action);
  }
  if (payload.citations && payload.citations.length) {
    body += '<div class="ask-cites">' + payload.citations.map((c) => {
      const title = esc(c.title || c.document_id || "Source");
      const section = c.section ? " · " + esc(c.section) : "";
      const source = c.source ? " · " + esc(c.source) : "";
      const link = c.url
        ? ' <a href="' + esc(c.url) + '" target="_blank" rel="noopener">' + title + "</a>"
        : title;
      return '<div class="ask-cite">' + link + section + source + "</div>";
    }).join("") + "</div>";
  }
  appendAskTurn("assistant", body, meta, !!payload.insufficient_context);
}

async function loadKnowledgeStatus() {
  try {
    const data = await fetch("/api/dashboard/knowledge/status").then((r) => r.json());
    const status = data.status || "offline";
    const lamp = $("knowledge-lamp");
    if (lamp) lamp.dataset.status = status;
    const label = $("knowledge-lamp-label");
    if (label) {
      label.textContent = status === "ok" ? "Knowledge ready"
        : status === "degraded" ? "Knowledge degraded"
        : "Knowledge offline";
    }
    const tile = $("stat-knowledge");
    if (tile) {
      tile.textContent = status === "ok" ? "Ready" : (status.charAt(0).toUpperCase() + status.slice(1));
      tile.style.color = status === "ok" ? "var(--status-ok)" : status === "degraded" ? "var(--status-warn)" : "var(--text-muted)";
    }
    const sub = $("stat-knowledge-sub");
    if (sub) sub.textContent = knowledgeStatSub(data, status);
    const tileWrap = tile && tile.closest(".stat-tile");
    if (tileWrap) {
      tileWrap.title = data.detail || "";
      if (data.deps_installed === false) {
        tileWrap.title = "Install optional extras: pip install -e '.[knowledge]'";
      }
    }
    const hint = $("ask-hint");
    if (hint) {
      hint.textContent = data.deps_installed === false
        ? "Ask Zyra is optional. Install with: pip install -e '.[knowledge]' — then set LLM_API_KEY and start Qdrant."
        : data.live_tools
        ? "Read-only knowledge + live cluster diagnostics enabled for: "
          + ((data.live_namespaces || []).join(", ") || "configured namespaces")
          + ". Mutations remain out of scope."
        : "Read-only knowledge agent — it will not mutate cluster state. Enable ENABLE_LIVE_CLUSTER_TOOLS for observed-state diagnostics.";
    }
    askStreamingPreferred = data.streaming !== false;
    const remPanel = $("remediation-panel");
    if (remPanel) remPanel.style.display = data.remediation ? "block" : "none";
  } catch (err) {
    const lamp = $("knowledge-lamp");
    if (lamp) lamp.dataset.status = "offline";
  }
}

async function loadAskSuggestions() {
  const chips = $("ask-chips");
  if (!chips) return;
  try {
    const data = await fetch("/api/dashboard/knowledge/suggestions").then((r) => r.json());
    const items = data.suggestions || [];
    chips.innerHTML = items.map((s) =>
      '<button type="button" class="ask-chip" data-q="' + esc(s.question) + '" data-p="' + esc(s.product || "") + '">'
      + esc((s.product ? s.product + ": " : "") + s.question) + "</button>"
    ).join("");
    for (const btn of chips.querySelectorAll(".ask-chip")) {
      btn.addEventListener("click", () => {
        $("ask-question").value = btn.dataset.q || "";
        if (btn.dataset.p) $("ask-product").value = btn.dataset.p;
        focusAskZyvor();
      });
    }
  } catch (err) {
    chips.innerHTML = "";
  }
