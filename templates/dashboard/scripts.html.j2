    const cell = (k, v) => '<div class="stat-tile p-8-12"><span class="stat-label">' + k + '</span><span class="stat-value" style="font-size:1rem">' + v + "ms</span></div>";
    html += '<div class="d-flex gap-8 wrap mt-10">'
      + cell("p50", r.p50) + cell("p95", r.p95) + cell("p99", r.p99) + cell("max", r.max) + cell("mean", r.mean) + "</div>";
  } else if (st.kind === "tls") {
