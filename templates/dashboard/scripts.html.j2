async function submitAsk() {
  if (askBusy) return;
  const question = ($("ask-question").value || "").trim();
  if (question.length < 2) {
    toast("Ask Zyra", false, "Enter a question");
    return;
  }
  askBusy = true;
  $("ask-submit").disabled = true;
  $("ask-status").textContent = askStreamingPreferred ? "streaming…" : "searching…";
  $("ask-latency").textContent = "";
  appendAskTurn("user", esc(question));
  try {
    localStorage.setItem(ASK_LS_DRAFT, "");
    localStorage.setItem(ASK_LS_PRODUCT, $("ask-product").value || "");
  } catch (e) { /* ignore */ }

  const body = {
    question,
    product: $("ask-product").value || null,
    document_type: $("ask-doctype").value || null,
    thread_id: askThreadId,
  };
  const started = performance.now();
  try {
    if (askStreamingPreferred) {
      await submitAskStream(body, started);
    } else {
      await submitAskJson(body, started);
    }
  } catch (err) {
    appendAskTurn("assistant", esc(String(err)), "", true);
    $("ask-status").textContent = "error";
  } finally {
    askBusy = false;
    $("ask-submit").disabled = false;
  }
}

async function submitAskJson(body, started) {
  const res = await fetch("/api/dashboard/ask", {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify(body),
  });
  const latency = parseFloat(res.headers.get("X-Response-Time-Ms") || "") || (performance.now() - started);
  const payload = await res.json();
  if (!res.ok) {
    appendAskTurn("assistant", esc(payload.detail || "Ask failed"), "", true);
    toast("Ask Zyra", false, payload.detail || ("HTTP " + res.status));
    $("ask-status").textContent = "failed";
    return;
  }
  finishAskPayload(payload, latency);
}

async function submitAskStream(body, started) {
  const res = await fetch("/api/dashboard/ask/stream", {
    method: "POST",
    headers: { "Content-Type": "application/json", "Accept": "text/event-stream" },
    body: JSON.stringify(body),
  });
  if (!res.ok || !res.body) {
    // Fall back to non-streaming ask.
    await submitAskJson(body, started);
    return;
  }
  const reader = res.body.getReader();
  const decoder = new TextDecoder();
  let buffer = "";
  let gotFinal = false;
  while (true) {
    const { done, value } = await reader.read();
    if (done) break;
    buffer += decoder.decode(value, { stream: true });
    const parts = buffer.split("\n\n");
    buffer = parts.pop() || "";
    for (const part of parts) {
      const line = part.split("\n").find((l) => l.startsWith("data: "));
      if (!line) continue;
      let event;
      try { event = JSON.parse(line.slice(6)); } catch (e) { continue; }
      if (event.event === "understanding") {
        $("ask-status").textContent = "understood · " + (event.data && event.data.intent ? event.data.intent : "routing");
      } else if (event.event === "tool_call") {
        $("ask-status").textContent = "tools · " + (event.tools || []).join(", ");
      } else if (event.event === "tool_result") {
        $("ask-status").textContent = "tool result · " + (event.tool || "ok");
      } else if (event.event === "warning") {
        $("ask-status").textContent = "degraded stream";
      } else if (event.event === "error") {
        appendAskTurn("assistant", esc(event.detail || "stream error"), "", true);
        $("ask-status").textContent = "failed";
        return;
      } else if (event.event === "final") {
        gotFinal = true;
        const payload = { ...(event.data || {}), thread_id: event.thread_id || (event.data && event.data.thread_id) };
        finishAskPayload(payload, performance.now() - started);
      }
    }
  }
  if (!gotFinal) {
    await submitAskJson(body, started);
  }
}

function finishAskPayload(payload, latency) {
  askThreadId = payload.thread_id || askThreadId;
  askLastPayload = payload;
  $("ask-thread-label").textContent = askThreadId ? askThreadId.slice(0, 18) : "new";
  renderAssistantPayload(payload, Number.isFinite(latency) ? latency : null);
  $("ask-question").value = "";
  $("ask-status").textContent = payload.insufficient_context ? "abstained" : "answered";
  if (Number.isFinite(latency)) $("ask-latency").textContent = Math.round(latency) + " ms";
}

async function submitRemediation() {
  const issue = ($("remediation-issue").value || "").trim();
  if (issue.length < 2) { toast("Remediation", false, "Describe the issue"); return; }
  $("remediation-status").textContent = "planning…";
  $("remediation-approve").style.display = "none";
  $("remediation-reject").style.display = "none";
  try {
    const res = await fetch("/api/dashboard/remediation", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ issue, thread_id: remediationThreadId }),
    });
    const data = await res.json();
    $("remediation-out").textContent = JSON.stringify(data, null, 2);
    if (!data.enabled) {
      $("remediation-status").textContent = "disabled";
      return;
    }
    remediationThreadId = data.thread_id || remediationThreadId;
    if (data.interrupted) {
      $("remediation-status").textContent = "awaiting approval";
      $("remediation-approve").style.display = "";
      $("remediation-reject").style.display = "";
    } else {
      $("remediation-status").textContent = "planned";
    }
  } catch (err) {
    $("remediation-status").textContent = "error";
    $("remediation-out").textContent = String(err);
  }
}

async function resumeRemediation(decision) {
  if (!remediationThreadId) { toast("Remediation", false, "No interrupt thread"); return; }
  $("remediation-status").textContent = decision + "…";
  const res = await fetch("/api/dashboard/remediation/resume", {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({ thread_id: remediationThreadId, decision }),
  });
  const data = await res.json();
  $("remediation-out").textContent = JSON.stringify(data, null, 2);
  $("remediation-approve").style.display = data.interrupted ? "" : "none";
  $("remediation-reject").style.display = data.interrupted ? "" : "none";
  $("remediation-status").textContent = data.interrupted ? "awaiting approval" : (decision + "d");
}

