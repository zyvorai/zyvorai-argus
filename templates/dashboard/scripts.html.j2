      + esc(r.host) + ":" + r.port + " → " + esc((r.ips || []).join(", ")) + "</div>";
    const row = (k, v) => "<tr><td class=\"d\" style=\"width:130px\">" + k + "</td><td>" + esc(String(v)) + "</td></tr>";
    html += '<table class="runs-table mt-8"><tbody>'
      + row("expires in", (r.days_left != null ? r.days_left + " days" : "?") + " (" + esc(r.expiry || "") + ")")
      + row("issuer", r.issuer) + row("subject", r.subject)
      + row("protocol", r.protocol + " · " + r.cipher)
      + row("SANs", (r.sans || []).slice(0, 8).join(", ")) + "</tbody></table>";
  } else if (st.kind === "compare") {
    const same = r.identical;
    html += '<div class="d">' + (same ? '<span class="pass">identical</span>' : '<span class="fail">' + r.diff_percent + "% different</span>")
      + " — " + esc(r.url_a) + " vs " + esc(r.url_b) + "</div>";
    html += '<div class="d-flex gap-12 wrap mt-10">'
      + [["A", r.a_href], ["B", r.b_href], ["diff", r.diff_href]].map(([lbl, href]) =>
        '<div><div class="d mb-4">' + lbl + "</div>"
        + '<a href="' + esc(href) + '" target="_blank"><img src="' + esc(href) + '" class="mw-230 b-sep r-8"></a></div>').join("")
      + "</div>";
  } else if (st.kind === "ping") {
    html += '<div class="d"><span class="pass">' + r.up + " up</span>"
      + (r.down ? ' · <span class="fail">' + r.down + " down</span>" : "") + " of " + r.total + "</div>";
    html += '<table class="runs-table mt-8"><tbody>'
      + (r.results || []).map((x) => "<tr><td><span class=\"chip " + (x.ok ? "pass" : "fail") + '">' + (x.status || "ERR") + "</span></td>"
        + "<td>" + esc(x.url) + "</td><td class=\"d\">" + (x.ms != null ? x.ms + "ms" : esc(x.error || "")) + "</td></tr>").join("")
      + "</tbody></table>";
  } else if (st.kind === "screenshot") {
    html += '<div class="d">' + esc(r.url) + " — HTTP " + (r.status || "?") + " · " + esc(r.title || "") + "</div>";
    html += '<div class="d-flex gap-12 wrap mt-10">'
      + (r.shots || []).map((s) => '<div><div class="d mb-4">' + esc(s.viewport) + " · " + s.width + "×" + s.height + '</div>'
        + '<a href="' + esc(s.href) + '" target="_blank"><img src="' + esc(s.href) + '" style="max-width:280px" class="b-sep r-8"></a></div>').join("")
      + "</div>";
  } else if (st.kind === "audit") {
    const checks = r.checks || [];
    const gc = r.grade === "A" ? "var(--status-ok)" : r.grade === "F" || r.grade === "D" ? "var(--status-error)" : "var(--status-warn)";
    html += '<div class="d-flex ai-center gap-14 mb-6">'
      + '<div style="color:' + gc + '" class="fs-44 fw-800 lh-1">' + esc(r.grade || "?") + "</div>"
      + '<div><div class="fw-600">Health score ' + (r.score != null ? r.score + "/100" : "") + "</div>"
      + '<div class="d">' + esc(r.url) + " — " + r.pages_audited + " page(s) · "
      + '<span class="fail">' + r.fail_count + " failing</span> · "
      + '<span class="c-warn">' + r.warn_count + " warnings</span></div></div></div>";
    // summary tiles per check
    html += '<div class="d-flex gap-8 wrap my-8">'
      + checks.map((c) => { const b = (r.by_check || {})[c] || {}; return '<span class="chip">' + esc(c) + ': '
        + '<span class="pass">' + (b.ok || 0) + "✓</span>"
        + (b.warn ? ' <span class="c-warn">' + b.warn + "!</span>" : "")
        + (b.fail ? ' <span class="fail">' + b.fail + "✗</span>" : "") + "</span>"; }).join("") + "</div>";
    // pages × checks matrix
    html += '<div class="scroll-x"><table class="runs-table"><tbody>'
      + "<tr><td><b>Page</b></td>" + checks.map((c) => "<td><b>" + esc(c) + "</b></td>").join("") + "</tr>"
      + (r.audit_pages || []).map((p) => "<tr><td>" + esc(p.path) + '</td>'
        + checks.map((c) => { const chk = (p.checks || {})[c]; if (!chk) return '<td class="d">–</td>';
          const col = chk.status === "ok" ? "var(--status-ok)" : chk.status === "warn" ? "var(--status-warn)" : "var(--status-error)";
          const iss = (chk.issues || []).join("\n");
          return '<td title="' + esc(iss) + '" style="color:' + col + ';cursor:' + (iss ? "help" : "default") + '">' + esc(chk.status) + "</td>"; }).join("")
        + "</tr>").join("")
      + "</tbody></table></div>";
  } else if (st.kind === "flaky") {
    html += '<div class="d">' + r.runs + " runs · <b class=\"" + (r.flaky_count ? "fail" : "pass") + "\">"
      + r.flaky_count + " flaky test(s)</b></div>";
    html += '<table class="runs-table mt-8"><tbody>'
      + (r.flaky_cases || []).slice(0, 30).map((c) => "<tr><td>"
        + '<span class="chip ' + (c.status === "passed" ? "pass" : "fail") + '">'
        + (c.status === "flaky" ? "FLAKY" : c.status.toUpperCase()) + "</span></td>"
        + "<td>" + esc(c.title) + "</td><td>" + c.passes + "/" + c.runs + " passed</td>"
        + '<td>' + (c.flake_pct ? '<span class="fail">' + c.flake_pct + "% flake</span>" : "") + "</td></tr>").join("")
      + "</tbody></table>";
  } else if (st.kind === "regression") {
    html += '<div class="d">' + (r.baselines_updated ? "baselines updated · " : "") + (r.diffs || []).length + " screenshot(s) compared</div>";
    if (r.diffs && r.diffs.length) {
      html += '<table class="runs-table mt-8"><tbody>'
        + r.diffs.map((d) => "<tr><td>" + esc(d.file) + '</td><td><span class="chip ' + (d.status === "fail" ? "fail" : "pass") + '">' + esc(d.status) + "</span></td><td>" + (d.diff_percent ?? 0) + "%</td><td>"
          + (d.diff_href ? '<a class="rlink" href="' + esc(d.diff_href) + '" target="_blank">diff image</a>' : esc(d.message || "")) + "</td></tr>").join("")
        + "</tbody></table>";
    }
  } else if (st.kind === "misconfig_scan") {
    const gc = r.grade === "A" ? "var(--status-ok)" : (r.grade === "F" || r.grade === "D") ? "var(--status-error)" : "var(--status-warn)";
    html += '<div class="d-flex ai-center gap-14 mb-6">'
      + '<div style="color:' + gc + '" class="fs-44 fw-800 lh-1">' + esc(r.grade || "?") + "</div>"
      + '<div><div class="fw-600">Score ' + (r.score != null ? r.score + "/100" : "") + "</div>"
      + '<div class="d">' + esc(r.url) + " — " + ((r.paths && r.paths.exposed) || []).length + " exposed path(s) · headers "
      + esc((r.headers && r.headers.status) || "?") + "</div></div></div>";
    if (r.tech && ((r.tech.signatures && r.tech.signatures.length) || (r.tech.versions && r.tech.versions.length))) {
      html += '<div class="d mb-6">detected: ' + esc((r.tech.signatures || []).join(", "))
        + " " + (r.tech.versions || []).map((v) => esc(v.product + " " + v.version)).join(", ") + "</div>";
    }
    html += '<div class="d">findings, if any, appear in the 🐞 Findings panel below.</div>';
  } else if (st.kind === "cve_lookup") {
    html += '<div class="d">' + esc(r.url) + " — <b class=\"" + (r.total_matches ? "fail" : "pass") + '">'
      + r.total_matches + " known advisory match(es)</b> across " + (r.identified || []).length + " identified component(s)</div>";
    html += '<table class="runs-table mt-8"><tbody>'
      + "<tr><th>product</th><th>version</th><th>matches</th></tr>"
      + (r.results || []).map((x) => "<tr><td>" + esc(x.product) + "</td><td>" + esc(x.version) + "</td><td>"
        + ((x.matches && x.matches.length)
            ? x.matches.map((m) => '<span class="chip fail">' + esc(m.id) + "</span>").join(" ")
            : ('<span class="d">' + esc(x.note || (x.error ? "lookup error" : "none")) + "</span>")) + "</td></tr>").join("")
      + "</tbody></table>";
  } else if (st.kind === "llm_redteam") {
    const gc = r.grade === "A" ? "var(--status-ok)" : (r.grade === "F" || r.grade === "D") ? "var(--status-error)" : "var(--status-warn)";
    html += '<div class="d-flex ai-center gap-14 mb-6">'
      + '<div style="color:' + gc + '" class="fs-44 fw-800 lh-1">' + esc(r.grade || "?") + "</div>"
      + '<div><div class="fw-600">' + r.resisted + "/" + r.total + " prompts resisted</div>"
      + '<div class="d">target: ' + esc(r.target) + "</div></div></div>";
    html += '<table class="runs-table mt-8"><tbody>'
      + "<tr><th>attack</th><th>category</th><th>result</th></tr>"
      + (r.results || []).map((x) => "<tr><td><code>" + esc(x.id) + "</code></td><td class=\"d\">" + esc(x.category) + "</td><td>"
        + (x.resisted == null ? '<span class="chip">error</span>' : '<span class="chip ' + (x.resisted ? "pass" : "fail") + '">' + (x.resisted ? "resisted" : "COMPROMISED") + "</span>") + "</td></tr>").join("")
      + "</tbody></table>";
  } else if (st.kind === "exploit_poc" || st.kind === "host_pentest" || st.kind === "cloud_pentest") {
    const label = st.kind === "exploit_poc" ? esc(r.url) : st.kind === "host_pentest" ? esc(r.host) : esc(r.provider) + ":" + esc(r.target);
    html += '<div class="d"><span class="chip ' + (r.verified ? "fail" : "pass") + '">' + (r.verified ? "VERIFIED" : "not verified") + "</span> "
      + label + (r.timed_out ? ' · <span class="c-warn">timed out</span>' : "") + "</div>";
    if (r.reason) html += '<div class="d mt-6">' + esc(r.reason) + "</div>";
    html += '<div class="d mt-8">PoC: <code>' + esc(r.poc_path || "") + "</code> (sha256 " + esc((r.code_sha256 || "").slice(0, 12)) + "…)</div>";
    if (r.stdout) html += '<pre style="max-height:220px;overflow:auto;font-size:.8rem" class="mt-8">' + esc(r.stdout) + "</pre>";
  } else if (st.kind === "attack_chain") {
    html += '<div class="d">' + r.confirmed_count + "/" + (r.steps || []).length + " step(s) confirmed — " + esc(r.stop_reason) + "</div>";
    html += '<table class="runs-table mt-8"><tbody>'
      + "<tr><th>step</th><th>description</th><th>result</th></tr>"
      + (r.steps || []).map((s) => "<tr><td>" + s.step + "</td><td>" + esc(s.description) + "</td><td>"
        + '<span class="chip ' + (s.verified ? "fail" : "pass") + '">' + (s.verified ? "VERIFIED" : "not verified") + "</span></td></tr>").join("")
      + "</tbody></table>";
  } else if (st.kind === "port_scan") {
    html += '<div class="d">' + esc(r.host) + " — <b>" + (r.open_ports || []).length + " open</b> of " + (r.scanned || 0) + " scanned</div>";
    html += '<div class="d mt-6">' + esc((r.open_ports || []).join(", ") || "none") + "</div>";
  } else if (st.kind === "tls_cipher_scan") {
    const gc = r.grade === "A" ? "var(--status-ok)" : (r.grade === "F" || r.grade === "D") ? "var(--status-error)" : "var(--status-warn)";
    html += '<div class="d-flex ai-center gap-14 mb-6">'
      + '<div style="color:' + gc + '" class="fs-44 fw-800 lh-1">' + esc(r.grade || "?") + "</div>"
      + '<div><div class="fw-600">' + esc((r.negotiated && r.negotiated.cipher) || "no handshake") + "</div>"
      + '<div class="d">' + esc(r.host) + ":" + (r.port || 443) + "</div></div></div>";
    if ((r.issues || []).length) html += '<ul class="d">' + r.issues.map((i) => "<li>" + esc(i) + "</li>").join("") + "</ul>";
  } else if (["dast_scan","injection_scan","csrf_probe","ssrf_probe","auth_attack_scan","idor_scan"].includes(st.kind)) {
    const items = r.findings || [];
    html += '<div class="d">' + esc(r.url || "") + " — <b class=\"" + (items.length ? "fail" : "pass") + '">'
      + items.length + " finding(s)</b></div>";
    if (items.length) {
      html += '<table class="runs-table mt-8"><tbody>'
        + "<tr><th>sev</th><th>title</th><th>where</th></tr>"
        + items.map((f) => "<tr><td><span class=\"chip fail\">" + esc(f.severity || "") + "</span></td><td>"
          + esc(f.title || "") + "</td><td class=\"d\">" + esc(f.where || "") + "</td></tr>").join("")
        + "</tbody></table>";
    }
  } else {
    html += '<div class="d">' + r.passed + "/" + r.total + " passed"
      + (r.report ? ' · <a class="rlink" href="' + esc(r.report) + '" target="_blank">📄 open report</a>' : "") + "</div>";
    if (r.generated && r.generated.length) {
      html += '<div class="result-files mt-6">' + r.generated.map(esc).join("<br>") + "</div>";
    }
    html += caseTable(r.cases);
  }
  if (r.report) html += downloadRow(r.report);
  else if (st.kind && !st.error) html += '<div class="dl-row"><button class="dl-btn" id="btn-rerun">⟳ Rerun</button></div>';
  panel.innerHTML = html;
  panel.style.display = "block";

  // wire result-panel controls
  const failsOnly = document.getElementById("fails-only");
  if (failsOnly) failsOnly.addEventListener("change", () => {
    for (const row of document.querySelectorAll("#case-table .case-row")) {
      row.style.display = (failsOnly.checked && !row.classList.contains("is-fail")) ? "none" : "";
    }
  });
  for (const b of panel.querySelectorAll(".copy-btn")) {
    b.addEventListener("click", () => {
      navigator.clipboard.writeText(decodeURIComponent(b.dataset.copy || "")).then(() => toast("copied", true, "error copied to clipboard"));
    });
  }
  const rerun = document.getElementById("btn-rerun");
  if (rerun) rerun.addEventListener("click", async () => {
    const res = await fetch("/api/dashboard/jobs/rerun", { method: "POST" });
    if (res.status === 409) { toast("rerun", false, "a job is already running"); return; }
    $("job-result").style.display = "none";
    sync();
  });
  const copyMd = document.getElementById("btn-copy-md");
  if (copyMd) copyMd.addEventListener("click", async () => {
    try {
      const md = await fetch("/api/dashboard/jobs/report.md").then((res) => res.text());
      await navigator.clipboard.writeText(md);
      toast("report", true, "Markdown copied — paste into a GitHub issue, PR, or Slack message");
    } catch (err) {
      toast("report", false, "Clipboard unavailable");
    }
  });
}

/* fast 2s status poll while a job is running, so the live log streams */
let busyPoll = null;
function ensureBusyPoll(busy) {
  if (busy && !busyPoll) {
    busyPoll = setInterval(async () => {
      try {
        const st = await fetch("/api/dashboard/jobs/status").then((r) => r.json());
        renderRunStatus(st);
        if (!st.running) {
          clearInterval(busyPoll); busyPoll = null; sync();
          if (videosOpen) loadVideos();
        }
      } catch (e) { /* next tick */ }
    }, 2000);
  } else if (!busy && busyPoll) {
    clearInterval(busyPoll); busyPoll = null;
  }
}

/* concurrent jobs (ZYVOR_JOBS_MAX_CONCURRENT > 1) run beside the slot job; list them with a Stop each */
let sidePoll = null;
async function loadSideJobs() {
  const box = $("side-jobs");
  if (!box) return;
  let rows = [];
  try {
    const res = await fetch("/api/dashboard/jobs");
    if (res.ok) {
      const data = await res.json();
      rows = data.jobs || [];
      jobCaps.max = data.max_concurrent || 1;
      jobCaps.kinds = new Set(data.concurrent_kinds || []);
    }
  } catch (e) { return; }
  const live = rows.filter((j) => j.concurrent && j.running);
  jobCaps.sides = live.length;
  applyBtnLock();
  if (!live.length) {
    box.style.display = "none"; box.innerHTML = "";
    if (sidePoll) { clearInterval(sidePoll); sidePoll = null; }
    return;
  }
  box.style.display = "block";
  box.innerHTML = "<strong>Also running</strong>" + live.map((j) => {
    const secs = j.started_at ? Math.max(0, (Date.now() - new Date(j.started_at).getTime()) / 1000 | 0) : 0;
    return '<div class="side-job"><span class="spin" aria-hidden="true"></span> '
      + esc(KIND_LABELS[j.kind] || j.kind) + '<span class="d"> · ' + rel(secs) + "</span>"
      + ' <button type="button" class="term-btn danger" data-stop-job="' + esc(j.job_id) + '">Stop</button></div>';
  }).join("");
  for (const b of box.querySelectorAll("[data-stop-job]")) {
    b.addEventListener("click", async () => {
      b.disabled = true;
      await fetch("/api/dashboard/jobs/" + encodeURIComponent(b.dataset.stopJob) + "/cancel", { method: "POST" });
      loadSideJobs();
    });
  }
  if (!sidePoll) sidePoll = setInterval(loadSideJobs, 3000);
}

async function sync() {
  loadSideJobs();
  try {
    const [overview, pods, runs, runSt] = await Promise.all([
      fetch("/api/dashboard/overview").then((r) => r.json()),
      fetch("/api/dashboard/pods").then((r) => r.json()),
      fetch("/api/dashboard/runs").then((r) => r.json()),
      fetch("/api/dashboard/jobs/status").then((r) => r.json()),
    ]);
    const runList = runs.runs || [];
    renderHero(overview, pods, runList);
    renderWorkloads(overview.workloads);
    renderPods(pods);
    renderRuns(runList);
    renderRunStatus(runSt);
    $("report-link").style.display = overview.report_available ? "inline" : "none";
    $("pdf-link").style.display = overview.pdf_available ? "inline" : "none";
    if (overview.auth && overview.auth.enabled) {
      $("session").style.display = "inline";
      $("session-user").textContent = overview.auth.user;
    }
    await refreshDrawer();
    loadKnowledgeStatus();
    lastSync = Date.now();
  } catch (err) {
    $("sync").textContent = "sync failed: " + err;
  }
}
setInterval(() => {
  if (lastSync) $("sync").textContent = "synced " + rel((Date.now() - lastSync) / 1000 | 0) + " ago";
}, 1000);

let refreshTimer = null;
function setRefreshRate(ms) {
  if (refreshTimer) clearInterval(refreshTimer);
  refreshTimer = ms > 0 ? setInterval(() => { sync(); if (eventsOpen) loadEvents(); }, ms) : null;
}
$("refresh-rate").value = String(localStorage.getItem("zyvor-refresh") || REFRESH);
$("refresh-rate").addEventListener("change", () => {
  localStorage.setItem("zyvor-refresh", $("refresh-rate").value);
  setRefreshRate(parseInt($("refresh-rate").value, 10));
});
sync();
loadTestHealth();
loadSchedules();
loadFindings();
loadEngagements();
loadRequirements();
loadRequirementImpact();
setInterval(loadSchedules, 15000);
setInterval(loadFindings, 15000);
setInterval(loadEngagements, 30000);
setInterval(loadRequirements, 30000);
setInterval(loadRequirementImpact, 30000);
setRefreshRate(parseInt($("refresh-rate").value, 10) || REFRESH);


document.getElementById("topbar-palette")?.addEventListener("click", () => openPalette());

