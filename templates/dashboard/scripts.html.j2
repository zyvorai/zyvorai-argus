/* run comparison: baseline vs candidate deltas */
function cmpDelta(a, b, unit, lowerIsBetter) {
  if (a == null || b == null) return '<span class="d">—</span>';
  const d = Math.round((b - a) * 100) / 100;
  if (d === 0) return '<span class="d">no change</span>';
  const good = lowerIsBetter ? d < 0 : d > 0;
  return '<b style="color:var(' + (good ? "--status-ok" : "--status-error") + ')">' + (d > 0 ? "+" : "") + d + unit + '</b>';
}
function renderCompare(runs) {
  const a = $("cmp-a"), b = $("cmp-b"), out = $("cmp-out");
  if (!a || !b) return;
  if (runs.length < 2) { out.innerHTML = '<span class="d">Run at least two QA runs to compare them.</span>'; return; }
  const opts = runs.slice(0, 30).map((r, i) => '<option value="' + i + '">' + esc((r.timestamp || "").replace("T", " ").slice(0, 16)) + ' · ' + r.passed + '/' + r.total + ' · ' + esc(r.source) + '</option>').join("");
  const keepA = a.value, keepB = b.value;
  a.innerHTML = opts; b.innerHTML = opts;
  a.value = keepA && a.querySelector('option[value="' + keepA + '"]') ? keepA : "1";
  b.value = keepB && b.querySelector('option[value="' + keepB + '"]') ? keepB : "0";
  const draw = () => {
    const ra = runs[+a.value], rb = runs[+b.value];
    const rate = (r) => r.total ? Math.round(1000 * r.passed / r.total) / 10 : null;
    const row = (k, x, y, delta) => '<tr><td>' + k + '</td><td>' + x + '</td><td>' + y + '</td><td>' + delta + '</td></tr>';
    const dur = (r) => r.duration_s != null ? Math.round(r.duration_s * 10) / 10 : null;
    out.innerHTML = '<table class="runs-table" aria-label="Run comparison"><thead><tr><th scope="col" class="d">Metric</th><th scope="col" class="d">Baseline</th><th scope="col" class="d">Candidate</th><th scope="col" class="d">Change</th></tr></thead><tbody>'
      + row("Pass rate", rate(ra) ?? "—", rate(rb) ?? "—", cmpDelta(rate(ra), rate(rb), " pts", false))
      + row("Failed", ra.failed, rb.failed, cmpDelta(ra.failed, rb.failed, "", true))
      + row("Total tests", ra.total, rb.total, cmpDelta(ra.total, rb.total, "", false))
      + row("Duration (s)", dur(ra) ?? "—", dur(rb) ?? "—", cmpDelta(dur(ra), dur(rb), "s", true))
      + row("V8 coverage %", ra.v8_coverage_percentage ?? "—", rb.v8_coverage_percentage ?? "—", cmpDelta(ra.v8_coverage_percentage, rb.v8_coverage_percentage, " pts", false))
      + '</tbody></table>';
  };
  a.onchange = draw; b.onchange = draw; draw();
}

/* single-series pass-rate sparkline with hover tooltip (accent blue) */
function renderSpark(runs) {
  const svg = $("spark");
  const pts = runs.slice(0, 30).reverse()
    .map((r) => ({ rate: r.total ? r.passed / r.total : 0, run: r }));
  if (pts.length < 2) { svg.innerHTML = ""; return; }
  const W = 268, H = 46, PAD = 3;
  const x = (i) => PAD + (i / (pts.length - 1)) * (W - 2 * PAD);
  const y = (rate) => H - PAD - rate * (H - 2 * PAD);
  const path = pts.map((p, i) => (i ? "L" : "M") + x(i).toFixed(1) + " " + y(p.rate).toFixed(1)).join(" ");
  const area = path + " L" + x(pts.length - 1).toFixed(1) + " " + (H - PAD) + " L" + x(0).toFixed(1) + " " + (H - PAD) + " Z";
  const last = pts[pts.length - 1];
  svg.innerHTML =
    '<defs><linearGradient id="sparkfill" x1="0" y1="0" x2="0" y2="1">'
    + '<stop offset="0%" stop-color="rgba(0,122,255,0.28)"/><stop offset="100%" stop-color="rgba(0,122,255,0)"/>'
    + '</linearGradient></defs>'
    + '<line x1="' + PAD + '" y1="' + y(1) + '" x2="' + (W - PAD) + '" y2="' + y(1) + '" stroke="rgba(255,255,255,0.08)" stroke-width="1"/>'
    + '<path d="' + area + '" fill="url(#sparkfill)" stroke="none"/>'
    + '<path d="' + path + '" fill="none" stroke="var(--accent)" stroke-width="2" stroke-linejoin="round" stroke-linecap="round"/>'
    + '<circle cx="' + x(pts.length - 1) + '" cy="' + y(last.rate) + '" r="3.5" fill="var(--accent)" stroke="rgb(28,28,30)" stroke-width="2"/>'
    + '<line id="spark-cross" y1="' + PAD + '" y2="' + (H - PAD) + '" stroke="var(--text-muted)" stroke-width="1" style="display:none"/>'
    + '<circle id="spark-dot" r="3.5" fill="var(--accent)" stroke="rgb(28,28,30)" stroke-width="2" style="display:none"/>';
  svg.onmousemove = (ev) => {
    const rect = svg.getBoundingClientRect();
    const i = Math.max(0, Math.min(pts.length - 1, Math.round(((ev.clientX - rect.left) / rect.width) * (pts.length - 1))));
    const p = pts[i];
    const cross = $("spark-cross"), dot = $("spark-dot"), tip = $("spark-tip");
    cross.setAttribute("x1", x(i)); cross.setAttribute("x2", x(i)); cross.style.display = "";
    dot.setAttribute("cx", x(i)); dot.setAttribute("cy", y(p.rate)); dot.style.display = "";
    tip.style.display = "block";
    tip.textContent = relIso(p.run.timestamp) + " — " + p.run.passed + "/" + p.run.total + " passed";
    const px = (x(i) / W) * rect.width;
    tip.style.left = Math.min(rect.width - 150, Math.max(0, px + 8)) + "px";
    tip.style.top = "-8px";
  };
  svg.onmouseleave = () => {
    $("spark-cross").style.display = "none";
    $("spark-dot").style.display = "none";
    $("spark-tip").style.display = "none";
  };
}

