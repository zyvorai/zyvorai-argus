async function loadRequirementImpact() {
  try {
    const graph = await fetch("/api/v2/requirements/impact-graph").then((r) => r.json());
    const models = Object.entries(graph.data_models || {}).filter(([, ids]) => ids.length > 1);
    const modelsEl = $("req-data-models");
    modelsEl.innerHTML = models.length
      ? models.map(([name, ids]) => '<div class="py-6 bt"><b>' + esc(name) + "</b><div class=\"d\" style=\"margin-top:2px\">"
          + ids.map((id) => '<a href="#requirements" class="req-link pointer underline" data-id="' + esc(id) + '">' + esc(id) + "</a>").join(", ")
          + "</div></div>").join("")
      : '<span class="d">No data model is shared by more than one requirement yet.</span>';

    const edges = graph.model_edges || [];
    const edgesEl = $("req-model-edges");
    if (edgesEl) {
      edgesEl.innerHTML = edges.length
        ? edges.slice(0, 40).map((e) => '<div class="py-6 bt"><b>'
            + esc(e.a) + "</b> ↔ <b>" + esc(e.b) + "</b>"
            + '<span class="d"> · weight ' + esc(String(e.weight || 1)) + "</span></div>").join("")
        : '<span class="d">No co-occurrence edges yet (need ≥2 models on one requirement).</span>';
    }

    const deps = graph.model_dependencies || [];
    const depsEl = $("req-model-deps");
    const canvas = $("req-dep-canvas");
    if (depsEl) {
      depsEl.innerHTML = deps.length
        ? deps.slice(0, 40).map((d) => '<div class="py-6 bt"><b>'
            + esc(d.source) + "</b> → <b>" + esc(d.target) + "</b>"
            + '<span class="d"> · ' + esc(d.relation || "depends_on")
            + (d.requirement_id ? " · " + esc(d.requirement_id) : "") + "</span></div>").join("")
        : '<span class="d">No typed dependencies yet (e.g. “Order depends on Payment”).</span>';
    }
    if (canvas) {
      if (deps.length) {
        canvas.style.display = "block";
        const nodes = [];
        const seen = new Set();
        for (const d of deps.slice(0, 24)) {
          for (const n of [d.source, d.target]) {
            if (!seen.has(n)) { seen.add(n); nodes.push(n); }
          }
        }
        const W = 640, H = 220, cx = W / 2, cy = H / 2, R = Math.min(W, H) * 0.36;
        const pos = {};
        nodes.forEach((n, i) => {
          const a = (2 * Math.PI * i) / Math.max(nodes.length, 1) - Math.PI / 2;
          pos[n] = { x: cx + R * Math.cos(a), y: cy + R * Math.sin(a) };
        });
        let svg = '<defs><marker id="dep-arrow" markerWidth="8" markerHeight="8" refX="6" refY="3" orient="auto"><path d="M0,0 L6,3 L0,6 Z" fill="currentColor"/></marker></defs>';
        for (const d of deps.slice(0, 24)) {
          const a = pos[d.source], b = pos[d.target];
          if (!a || !b) continue;
          svg += '<line x1="' + a.x + '" y1="' + a.y + '" x2="' + b.x + '" y2="' + b.y
            + '" stroke="currentColor" stroke-opacity="0.45" stroke-width="1.5" marker-end="url(#dep-arrow)"/>';
        }
        for (const n of nodes) {
          const p = pos[n];
          svg += '<circle cx="' + p.x + '" cy="' + p.y + '" r="18" fill="rgba(255,138,61,0.15)" stroke="currentColor" stroke-opacity="0.5"/>'
            + '<text x="' + p.x + '" y="' + (p.y + 4) + '" text-anchor="middle" font-size="11" fill="currentColor">' + esc(n) + "</text>";
        }
        canvas.innerHTML = svg;
      } else {
        canvas.style.display = "none";
        canvas.innerHTML = "";
      }
    }

    const flows = Object.entries(graph.flows || {});
    const flowsEl = $("req-flows");
    flowsEl.innerHTML = flows.length
      ? flows.map(([name, info]) => '<div class="py-6 bt"><b>' + esc(name) + "</b>"
          + '<div class="d mt-2">requirements: ' + info.requirements.map((id) => '<a href="#requirements" class="req-link pointer underline" data-id="' + esc(id) + '">' + esc(id) + "</a>").join(", ") + "</div>"
          + (info.tests.length ? '<div class="d mt-2">tests: ' + info.tests.map((t) => "<code>" + esc(t) + "</code>").join(", ") + "</div>" : "")
          + "</div>").join("")
      : '<span class="d">No requirement has a flow tagged yet.</span>';

    for (const el of document.querySelectorAll("#panel-requirements .req-link")) {
      el.addEventListener("click", (ev) => { ev.preventDefault(); openRequirementDetail(el.dataset.id); });
    }
  } catch (e) { /* offline */ }
}

