<section id="panel-pipeline" class="panel">
  <div class="panel-head">
    <h1>Pipeline</h1>
    <p>Generate, discover, and run tests from specs or plain English.</p>
  </div>
  <div class="acts">
<div class="glass card act" id="action-run-tests">
      <div class="act-title">▶ Run tests</div>
      <div class="act-row">
        <label class="select-field"><span>Source</span><select class="inp" id="run-source"><option value="local">local</option><option value="github">github</option></select></label>
        <input aria-label="Spec path" class="inp grow" id="run-spec" placeholder="spec path (optional)" list="spec-list">
      </div>
      <div class="act-row">
        <input aria-label="Pull request number" class="inp w-80" id="run-pr" type="number" placeholder="PR #">
        <label class="chk"><input type="checkbox" id="run-coverage"> expand coverage</label>
      </div>
      <div class="act-row">
        <input aria-label="Grep tag" class="inp grow mw-180" id="sm-grep" placeholder="grep tag (e.g. @smoke)">
        <input aria-label="Shard" class="inp mw-100" id="sm-shard" placeholder="shard 1/2">
        <button class="run-btn primary act-btn" data-kind="smoke">▶ Smoke</button>
        <button class="run-btn act-btn" data-kind="full">▶ Full pipeline</button>
      </div>
    </div>
    
<div class="glass card act" id="action-generate">
      <div class="act-title">⚙ Generate tests</div>
      <div class="act-row">
        <label class="select-field"><span>Source</span><select class="inp" id="gen-source"><option value="local">local</option><option value="github">github</option></select></label>
        <input aria-label="Spec path" class="inp grow" id="gen-spec" placeholder="spec path (optional)" list="spec-list">
      </div>
      <div class="act-row"><label class="chk"><input type="checkbox" id="gen-coverage"> expand coverage</label></div>
      <div class="act-row"><button class="run-btn act-btn" data-kind="generate">⚙ Generate</button></div>
    </div>
    
<div class="glass card act" id="action-discover">
      <div class="act-title">🔎 Discover coverage</div>
      <div class="d mb-8">Scan repo code/docs for untested routes and pages.</div>
      <div class="act-row">
        <label class="select-field"><span>Source</span><select class="inp" id="disc-source"><option value="github">github</option><option value="local">local</option></select></label>
        <button class="run-btn act-btn" data-kind="discover">🔎 Discover</button>
      </div>
    </div>
    
<div class="glass card act" id="action-create">
      <div class="act-title">✨ Create from English <span class="d fw-400">— AI when a key is set, heuristic otherwise</span></div>
      <div class="act-row"><textarea aria-label="Description" class="inp grow" id="nl-desc" rows="2" placeholder="e.g. Verify /vm page mentions KubeVirt migration"></textarea></div>
      <div class="act-row gap-6" id="nl-chips">
        <button type="button" class="chip nl-chip">homepage shows all products</button>
        <button type="button" class="chip nl-chip">/vm mentions KubeVirt</button>
        <button type="button" class="chip nl-chip">Schedule Demo button works</button>
      </div>
      <div class="act-row">
        <label class="chk"><input type="checkbox" id="nl-execute"> run immediately</label>
        <button class="run-btn act-btn" data-kind="create">✨ Create</button>
      </div>
    </div>
    
  </div>
</section>
